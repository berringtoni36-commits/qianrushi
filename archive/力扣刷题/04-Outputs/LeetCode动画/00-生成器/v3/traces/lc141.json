  "code": {
    "language": "cpp",
    "text": "/**\n * Definition for singly-linked list.\n * struct ListNode {\n *     int val;\n *     ListNode *next;\n *     ListNode(int x) : val(x), next(NULL) {}\n * };\n */\nclass Solution {\npublic:\n    bool hasCycle(ListNode *head) {\n        if (!head || !head->next) return false;\n        auto s = head, f = head->next;                           \n        while (f) {\n            s = s->next, f = f->next;                            \n            if (!f) return false;\n            f = f->next;                                         \n            if (s == f) return true;\n        }\n        return false;\n    }\n};",
    "lines": [
      {
        "id": "L1",
        "sourceLine": 1354,
        "text": "/**"
      },
