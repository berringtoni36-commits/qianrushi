      },
      {
        "id": "L9",
        "sourceLine": 1362,
        "text": "class Solution {"
      },
      {
        "id": "L10",
        "sourceLine": 1363,
        "text": "public:"
      },
      {
        "id": "L11",
        "sourceLine": 1364,
        "text": "    bool hasCycle(ListNode *head) {"
      },
      {
        "id": "L12",
        "sourceLine": 1365,
        "text": "        if (!head || !head->next) return false;"
      },
      {
        "id": "L13",
        "sourceLine": 1366,
        "text": "        auto s = head, f = head->next;                           "
      },
      {
        "id": "L14",
        "sourceLine": 1367,
        "text": "        while (f) {"
      },
      {
        "id": "L15",
        "sourceLine": 1368,
        "text": "            s = s->next, f = f->next;                            "
      },
      {
        "id": "L16",
        "sourceLine": 1369,
        "text": "            if (!f) return false;"
      },
      {
        "id": "L17",
        "sourceLine": 1370,
        "text": "            f = f->next;                                         "
      },
      {
        "id": "L18",
        "sourceLine": 1371,
        "text": "            if (s == f) return true;"
      },
      {
        "id": "L19",
        "sourceLine": 1372,
        "text": "        }"
      },
      {
        "id": "L20",
        "sourceLine": 1373,
        "text": "        return false;"
      },
