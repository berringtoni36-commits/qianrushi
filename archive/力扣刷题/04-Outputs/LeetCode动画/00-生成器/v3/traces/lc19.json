    "language": "cpp",
    "text": "/**\n * Definition for singly-linked list.\n * struct ListNode {\n *     int val;\n *     ListNode *next;\n *     ListNode(int x) : val(x), next(NULL) {}\n * };\n */\nclass Solution {\npublic:\n    ListNode* removeNthFromEnd(ListNode* head, int k) {\n        auto dummy = new ListNode(-1);\n        dummy->next = head;                                      \n\n        int n = 0;\n        for (auto p = dummy; p; p = p->next) n ++ ;              \n\n        auto p = dummy;\n        for (int i = 0; i < n - k - 1; i ++ ) p = p->next;       // 遍历\n        p->next = p->next->next;                                 \n\n        return dummy->next;\n    }\n};",
