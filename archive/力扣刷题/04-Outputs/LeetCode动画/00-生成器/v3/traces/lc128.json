  "code": {
    "language": "cpp",
    "text": "class Solution {\npublic:\n    int longestConsecutive(vector<int>& nums) {\n        unordered_set<int> S;                                    // 哈希集合，去重+O(1)查找\n        for (auto x: nums) S.insert(x);\n\n        int res = 0;\n        for (auto x: nums) {\n            if (S.count(x) && !S.count(x - 1)) {\n                int y = x;\n                S.erase(x);\n                while (S.count(y + 1)) {                         // 向后延伸连续序列\n                    y ++ ;\n                    S.erase(y);\n                }\n                res = max(res, y - x + 1);\n            }\n        }\n\n        return res;\n    }\n};",
