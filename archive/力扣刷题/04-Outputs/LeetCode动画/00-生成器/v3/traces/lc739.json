    "language": "cpp",
    "text": "class Solution {\npublic:\n    vector<int> dailyTemperatures(vector<int>& T) {\n        stack<int> stk;\n        vector<int> res(T.size());\n        for (int i = T.size() - 1; i >= 0; i -- ) {\n            while (stk.size() && T[i] >= T[stk.top()]) stk.pop();  // 出栈\n            if (stk.size()) res[i] = stk.top() - i;\n            stk.push(i);                                         // 入栈\n        }\n        return res;\n    }\n};",
