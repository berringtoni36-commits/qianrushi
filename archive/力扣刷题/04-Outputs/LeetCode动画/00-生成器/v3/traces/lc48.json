  "code": {
    "language": "cpp",
    "text": "class Solution {\npublic:\n    void rotate(vector<vector<int>>& matrix) {\n        int n = matrix.size();\n        for (int i = 0; i < n; i ++ )                            // 遍历\n            for (int j = 0; j < i; j ++ )\n                swap(matrix[i][j], matrix[j][i]);                // 交换\n\n        for (int i = 0; i < n; i ++ )                            // 遍历\n            for (int j = 0, k = n - 1; j < k; j ++, k -- )\n                swap(matrix[i][j], matrix[i][k]);                // 交换\n    }\n};",
