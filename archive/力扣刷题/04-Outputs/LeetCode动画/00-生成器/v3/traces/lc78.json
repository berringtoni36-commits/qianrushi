  "code": {
    "language": "cpp",
    "text": "class Solution {\npublic:\n    vector<vector<int>> subsets(vector<int>& nums) {\n        vector<vector<int>> res;\n        int n = nums.size();\n        for (int i = 0; i < 1 << n; i ++ ) {\n            vector<int> path;\n            for (int j = 0; j < n; j ++ )\n                if (i >> j & 1)\n                    path.push_back(nums[j]);\n            res.push_back(path);                                 // 记录结果\n        }\n\n        return res;\n    }\n};",
