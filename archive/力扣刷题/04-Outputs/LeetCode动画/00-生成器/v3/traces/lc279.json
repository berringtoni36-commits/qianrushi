  "code": {
    "language": "cpp",
    "text": "class Solution {\npublic:\n    bool check(int x) {\n        int r = sqrt(x);\n        return r * r == x;\n    }\n\n    int numSquares(int n) {\n        if (check(n)) return 1;\n\n        for (int a = 1; a <= n / a; a ++ )\n            if (check(n - a * a))\n                return 2;\n\n        while (n % 4 == 0) n /= 4;\n        if (n % 8 != 7) return 3;\n        return 4;\n    }\n};",
