  "code": {
    "language": "cpp",
    "text": "class Solution {\npublic:\n    int uniquePaths(int m, int n) {\n        vector<vector<int>> f(n, vector<int>(m));\n        for (int i = 0; i < n; i ++ )                            // 遍历\n            for (int j = 0; j < m; j ++ )\n                if (!i && !j) f[i][j] = 1;\n                else {\n                    if (i) f[i][j] += f[i - 1][j];\n                    if (j) f[i][j] += f[i][j - 1];\n                }\n\n        return f[n - 1][m - 1];\n    }\n};",
