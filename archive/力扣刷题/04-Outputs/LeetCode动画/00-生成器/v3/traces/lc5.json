    "text": "class Solution {\npublic:\n    string longestPalindrome(string s) {\n        string res;\n        for (int i = 0; i < s.size(); i ++ ) {\n            int l = i - 1, r = i + 1;\n            while (l >= 0 && r < s.size() && s[l] == s[r]) l --, r ++ ;\n            if (res.size() < r - l - 1) res = s.substr(l + 1, r - l - 1);\n\n            l = i, r = i + 1;\n            while (l >= 0 && r < s.size() && s[l] == s[r]) l --, r ++ ;\n            if (res.size() < r - l - 1) res = s.substr(l + 1, r - l - 1);\n        }\n\n        return res;\n    }\n};",
