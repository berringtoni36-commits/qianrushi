        "id": "L13",
        "sourceLine": 1289,
        "text": "        for (auto p = head; p; p = p->next) n ++ ;               "
      },
      {
        "id": "L14",
        "sourceLine": 1290,
        "text": "        if (n <= 1) return true;"
      },
      {
        "id": "L15",
        "sourceLine": 1291,
        "text": "        int half = n / 2;"
      },
      {
        "id": "L16",
        "sourceLine": 1292,
        "text": "        auto a = head;"
      },
      {
        "id": "L17",
        "sourceLine": 1293,
        "text": "        for (int i = 0; i < n - half; i ++ ) a = a->next;        // 遍历"
      },
      {
        "id": "L18",
        "sourceLine": 1294,
        "text": "        auto b = a->next;                                        "
      },
      {
        "id": "L19",
        "sourceLine": 1295,
        "text": "        for (int i = 0; i < half - 1; i ++ ) {"
      },
      {
        "id": "L20",
        "sourceLine": 1296,
        "text": "            auto c = b->next;                                    "
      },
      {
        "id": "L21",
        "sourceLine": 1297,
        "text": "            b->next = a;                                         "
      },
      {
        "id": "L22",
        "sourceLine": 1298,
        "text": "            a = b, b = c;"
      },
      {
        "id": "L23",
        "sourceLine": 1299,
        "text": "        }"
      },
      {
        "id": "L24",
        "sourceLine": 1300,
        "text": ""
      },
      {
        "id": "L25",
        "sourceLine": 1301,
        "text": "        auto p = head, q = a;"
      },
      {
        "id": "L26",
        "sourceLine": 1302,
        "text": "        bool success = true;"
      },
      {
        "id": "L27",
        "sourceLine": 1303,
        "text": "        for (int i = 0; i < half; i ++ ) {"
      },
      {
        "id": "L28",
        "sourceLine": 1304,
        "text": "            if (p->val != q->val) {"
      },
      {
        "id": "L29",
        "sourceLine": 1305,
        "text": "                success = false;"
      },
      {
        "id": "L30",
        "sourceLine": 1306,
        "text": "                break;"
      },
      {
        "id": "L31",
        "sourceLine": 1307,
        "text": "            }"
      },
      {
        "id": "L32",
        "sourceLine": 1308,
        "text": "            p = p->next;                                         "
      },
      {
        "id": "L33",
        "sourceLine": 1309,
        "text": "            q = q->next;                                         "
      },
      {
        "id": "L34",
        "sourceLine": 1310,
        "text": "        }"
      },
      {
        "id": "L35",
        "sourceLine": 1311,
        "text": ""
      },
      {
        "id": "L36",
        "sourceLine": 1312,
        "text": "        auto tail = a;"
      },
      {
        "id": "L37",
        "sourceLine": 1313,
        "text": "        b = a->next;                                             "
      },
      {
        "id": "L38",
        "sourceLine": 1314,
        "text": "        // 将链表恢复原状"
      },
      {
        "id": "L39",
        "sourceLine": 1315,
        "text": "        for (int i = 0; i < half - 1; i ++ ) {"
      },
      {
        "id": "L40",
        "sourceLine": 1316,
        "text": "            auto c = b->next;                                    "
      },
      {
        "id": "L41",
        "sourceLine": 1317,
        "text": "            b->next = a;                                         "
      },
      {
        "id": "L42",
        "sourceLine": 1318,
        "text": "            a = b, b = c;"
      },
      {
        "id": "L43",
        "sourceLine": 1319,
        "text": "        }"
      },
      {
        "id": "L44",
        "sourceLine": 1320,
        "text": ""
      },
      {
        "id": "L45",
        "sourceLine": 1321,
        "text": "        tail->next = NULL;                                       "
      },
      {
        "id": "L46",
        "sourceLine": 1322,
        "text": "        return success;"
      },
      {
        "id": "L47",
        "sourceLine": 1323,
        "text": "    }"
      },
      {
        "id": "L48",
        "sourceLine": 1324,
        "text": "};"
      }
    ]
  }
}
