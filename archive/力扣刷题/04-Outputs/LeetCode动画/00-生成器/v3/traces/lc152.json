  "code": {
    "language": "cpp",
    "text": "class Solution {\npublic:\n    int maxProduct(vector<int>& nums) {\n        int res = nums[0];\n        int f = nums[0], g = nums[0];\n        for (int i = 1; i < nums.size(); i ++ ) {\n            int a = nums[i], fa = f * a, ga = g * a;\n            f = max(a, max(fa, ga));\n            g = min(a, min(fa, ga));\n            res = max(res, f);\n        }\n        return res;\n    }\n};",
