  "code": {
    "language": "cpp",
    "text": "class Solution {\npublic:\n    int findDuplicate(vector<int>& nums) {\n        int a = 0, b = 0;\n        while (true) {\n            a = nums[a];\n            b = nums[nums[b]];\n            if (a == b) {\n                a = 0;\n                while (a != b) {\n                    a = nums[a];\n                    b = nums[b];\n                }\n                return a;\n            }\n        }\n\n        return -1;\n    }\n};",
