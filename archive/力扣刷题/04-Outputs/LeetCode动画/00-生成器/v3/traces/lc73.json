  "code": {
    "language": "cpp",
    "text": "class Solution {\npublic:\n    void setZeroes(vector<vector<int>>& matrix) {\n        if (matrix.empty() || matrix[0].empty()) return;\n        int n = matrix.size(), m = matrix[0].size();\n\n        int r0 = 1, c0 = 1;\n        for (int i = 0; i < m; i ++ ) if (!matrix[0][i]) r0 = 0;\n        for (int i = 0; i < n; i ++ ) if (!matrix[i][0]) c0 = 0; // 遍历\n\n        for (int i = 1; i < m; i ++ )\n            for (int j = 0; j < n; j ++ )\n                if (!matrix[j][i])\n                    matrix[0][i] = 0;\n\n        for (int i = 1; i < n; i ++ )\n            for (int j = 0; j < m; j ++ )\n                if (!matrix[i][j])\n                    matrix[i][0] = 0;\n\n        for (int i = 1; i < m; i ++ )\n            if (!matrix[0][i])\n                for (int j = 0; j < n; j ++ )\n                    matrix[j][i] = 0;\n\n        for (int i = 1; i < n; i ++ )\n            if (!matrix[i][0])\n                for (int j = 0; j < m; j ++ )\n                    matrix[i][j] = 0;\n\n        if (!r0) for (int i = 0; i < m; i ++ ) matrix[0][i] = 0;\n        if (!c0) for (int i = 0; i < n; i ++ ) matrix[i][0] = 0; // 遍历\n    }\n};",
