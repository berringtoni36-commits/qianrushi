  "code": {
    "language": "cpp",
    "text": "/**\n * Definition for a binary tree node.\n * struct TreeNode {\n *     int val;\n *     TreeNode *left;\n *     TreeNode *right;\n *     TreeNode(int x) : val(x), left(NULL), right(NULL) {}\n * };\n */\nclass Solution {\npublic:\n    TreeNode* invertTree(TreeNode* root) {\n        if (!root) return NULL;\n        swap(root->left, root->right);                           // 交换\n        invertTree(root->left);\n        invertTree(root->right);\n        return root;\n    }\n};",
