  "code": {
    "language": "cpp",
    "text": "class Solution {\npublic:\n    void sortColors(vector<int>& nums) {\n        for (int i = 0, j = 0, k = nums.size() - 1; i <= k;) {\n            if (nums[i] == 0) swap(nums[i ++ ], nums[j ++ ]);\n            else if (nums[i] == 2) swap(nums[i], nums[k -- ]);\n            else i ++ ;  // 当前值太小，排除当前行\n        }\n    }\n};",
