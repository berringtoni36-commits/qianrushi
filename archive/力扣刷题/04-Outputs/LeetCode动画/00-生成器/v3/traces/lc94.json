  "code": {
    "language": "cpp",
    "text": "/**\n * Definition for a binary tree node.\n * struct TreeNode {\n *     int val;\n *     TreeNode *left;\n *     TreeNode *right;\n *     TreeNode(int x) : val(x), left(NULL), right(NULL) {}\n * };\n */\nclass Solution {\npublic:\n    vector<int> ans;\n    vector<int> inorderTraversal(TreeNode* root) {\n        dfs(root);\n        return ans;\n    }\n\n    void dfs(TreeNode* root) {                                   // 深度优先搜索\n        if (!root) return;\n        dfs(root->left);\n        ans.push_back(root->val);                                // 记录结果\n        dfs(root->right);\n    }\n};",
