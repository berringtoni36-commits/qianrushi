  "code": {
    "language": "cpp",
    "text": "class Solution {\npublic:\n    vector<int> topKFrequent(vector<int>& nums, int k) {\n        unordered_map<int, int> cnt;                             // 哈希表，O(1)查找\n        for (auto x: nums) cnt[x] ++ ;\n        int n = nums.size();\n        vector<int> s(n + 1);\n        for (auto [x, c]: cnt) s[c] ++ ;\n        int i = n, t = 0;\n        while (t < k) t += s[i -- ];  // 从高频往低频累加，找到第k个的边界\n        vector<int> res;\n        for (auto [x, c]: cnt)\n            if (c > i)\n                res.push_back(x);                                // 记录结果\n        return res;\n    }\n};",
