  "code": {
    "language": "cpp",
    "text": "class Solution {\npublic:\n    void nextPermutation(vector<int>& nums) {\n        int k = nums.size() - 1;\n        while (k > 0 && nums[k - 1] >= nums[k]) k -- ;\n        if (k <= 0) {\n            reverse(nums.begin(), nums.end());\n        } else {\n            int t = k;\n            while (t < nums.size() && nums[t] > nums[k - 1]) t ++ ;\n            swap(nums[t - 1], nums[k - 1]);                      // 交换\n            reverse(nums.begin() + k, nums.end());\n        }\n    }\n};",
