  "code": {
    "language": "cpp",
    "text": "class Solution {\npublic:\n    int lengthOfLIS(vector<int>& nums) {\n        int n = nums.size();\n        vector<int> q;\n        for (auto x: nums) {\n            if (q.empty() || x > q.back()) q.push_back(x);       // 入队\n            else {\n                if (x <= q[0]) q[0] = x;\n                else {\n                    int l = 0, r = q.size() - 1;\n                    while (l < r) {\n                        int mid = l + r + 1 >> 1;\n                        if (q[mid] < x) l = mid;\n                        else r = mid - 1;\n                    }\n                    q[r + 1] = x;\n                }\n            }\n        }\n        return q.size();\n    }\n};",
