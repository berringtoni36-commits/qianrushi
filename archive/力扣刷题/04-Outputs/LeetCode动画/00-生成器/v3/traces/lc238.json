  "code": {
    "language": "cpp",
    "text": "class Solution {\npublic:\n    vector<int> productExceptSelf(vector<int>& nums) {\n        int n = nums.size();\n        vector<int> p(n, 1);\n        for (int i = 1; i < n; i ++ ) p[i] = p[i - 1] * nums[i - 1];\n        for (int i = n - 1, s = 1; i >= 0; i -- ) {\n            p[i] *= s;\n            s *= nums[i];\n        }\n        return p;\n    }\n};",
