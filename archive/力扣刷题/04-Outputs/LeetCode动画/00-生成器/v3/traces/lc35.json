  "code": {
    "language": "cpp",
    "text": "class Solution {\npublic:\n    int searchInsert(vector<int>& nums, int target) {\n        int l = 0, r = nums.size();\n\n        while (l < r) {\n            int mid = l + r >> 1;\n            if (nums[mid] >= target) r = mid;\n            else l = mid + 1;\n        }\n\n        return l;\n    }\n};",
