  "code": {
    "language": "cpp",
    "text": "class Solution {\npublic:\n    int lengthOfLongestSubstring(string s) {\n        unordered_map<char, int> heap;                           // 哈希表，O(1)查找\n        int res = 0;\n        for (int i = 0, j = 0; i < s.size(); i ++ ) {\n            heap[s[i]] ++ ;\n            while (heap[s[i]] > 1) heap[s[j ++ ]] -- ;\n            res = max(res, i - j + 1);\n        }\n        return res;\n    }\n};",
