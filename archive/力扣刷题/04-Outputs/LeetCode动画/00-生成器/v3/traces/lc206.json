        "text": " * Definition for singly-linked list."
      },
      {
        "id": "L3",
        "sourceLine": 1227,
        "text": " * struct ListNode {"
      },
      {
        "id": "L4",
        "sourceLine": 1228,
        "text": " *     int val;"
      },
      {
        "id": "L5",
        "sourceLine": 1229,
        "text": " *     ListNode *next;"
      },
      {
        "id": "L6",
        "sourceLine": 1230,
        "text": " *     ListNode(int x) : val(x), next(NULL) {}"
      },
      {
        "id": "L7",
        "sourceLine": 1231,
        "text": " * };"
      },
      {
        "id": "L8",
        "sourceLine": 1232,
        "text": " */"
      },
      {
        "id": "L9",
        "sourceLine": 1233,
        "text": "class Solution {"
      },
      {
        "id": "L10",
        "sourceLine": 1234,
        "text": "public:"
      },
      {
        "id": "L11",
        "sourceLine": 1235,
        "text": "    ListNode* reverseList(ListNode* head) {"
      },
      {
        "id": "L12",
        "sourceLine": 1236,
        "text": "        if (!head) return NULL;"
      },
      {
        "id": "L13",
        "sourceLine": 1237,
        "text": "        auto a = head, b = a->next;                              "
      },
      {
        "id": "L14",
        "sourceLine": 1238,
        "text": "        while (b) {"
      },
      {
        "id": "L15",
        "sourceLine": 1239,
        "text": "            auto c = b->next;                                    "
      },
      {
        "id": "L16",
        "sourceLine": 1240,
        "text": "            b->next = a;                                         "
      },
      {
        "id": "L17",
        "sourceLine": 1241,
        "text": "            a = b;"
      },
      {
        "id": "L18",
        "sourceLine": 1242,
        "text": "            b = c;"
      },
      {
        "id": "L19",
        "sourceLine": 1243,
        "text": "        }"
      },
      {
        "id": "L20",
        "sourceLine": 1244,
        "text": "        head->next = NULL;                                       "
      },
      {
        "id": "L21",
        "sourceLine": 1245,
        "text": "        return a;"
      },
      {
        "id": "L22",
        "sourceLine": 1246,
        "text": "    }"
      },
      {
        "id": "L23",
        "sourceLine": 1247,
        "text": "};"
      }
    ]
