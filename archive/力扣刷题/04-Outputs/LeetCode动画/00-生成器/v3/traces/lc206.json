  "code": {
    "language": "cpp",
    "text": "/**\n * Definition for singly-linked list.\n * struct ListNode {\n *     int val;\n *     ListNode *next;\n *     ListNode(int x) : val(x), next(NULL) {}\n * };\n */\nclass Solution {\npublic:\n    ListNode* reverseList(ListNode* head) {\n        if (!head) return NULL;\n        auto a = head, b = a->next;                              \n        while (b) {\n            auto c = b->next;                                    \n            b->next = a;                                         \n            a = b;\n            b = c;\n        }\n        head->next = NULL;                                       \n        return a;\n    }\n};",
    "lines": [
      {
        "id": "L1",
        "sourceLine": 1225,
        "text": "/**"
      },
      {
        "id": "L2",
