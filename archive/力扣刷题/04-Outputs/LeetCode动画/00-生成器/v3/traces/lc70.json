  "code": {
    "language": "cpp",
    "text": "class Solution {\npublic:\n    int climbStairs(int n) {\n        int a = 1, b = 1;\n        while ( -- n) {\n            int c = a + b;\n            a = b, b = c;\n        }\n        return b;\n    }\n};",
