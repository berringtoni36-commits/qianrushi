  "code": {
    "language": "cpp",
    "text": "class Solution {\npublic:\n    int majorityElement(vector<int>& nums) {\n        int r, c = 0;\n        for (auto x: nums)\n            if (!c) r = x, c = 1;\n            else if (r == x) c ++ ;\n            else c -- ;\n        return r;\n    }\n};",
