  "code": {
    "language": "cpp",
    "text": "class Solution {\npublic:\n    vector<vector<int>> generate(int n) {\n        vector<vector<int>> f;\n        for (int i = 0; i < n; i ++ ) {                          // 遍历\n            vector<int> line(i + 1);\n            line[0] = line[i] = 1;\n            for (int j = 1; j < i; j ++ )\n                line[j] = f[i - 1][j - 1] + f[i - 1][j];\n            f.push_back(line);\n        }\n        return f;\n    }\n};",
