  "code": {
    "language": "cpp",
    "text": "class Solution {\npublic:\n    void moveZeroes(vector<int>& nums) {\n        int k = 0;\n        for (auto x: nums)\n            if (x)\n                nums[k ++ ] = x;\n        while (k < nums.size()) nums[k ++ ] = 0;\n    }\n};",
