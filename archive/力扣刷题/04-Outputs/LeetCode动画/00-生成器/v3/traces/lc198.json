  "code": {
    "language": "cpp",
    "text": "class Solution {\npublic:\n    int rob(vector<int>& nums) {\n        int n = nums.size();\n        vector<int> f(n + 1), g(n + 1);\n        for (int i = 1; i <= n; i ++ ) {\n            f[i] = g[i - 1] + nums[i - 1];\n            g[i] = max(f[i - 1], g[i - 1]);\n        }\n        return max(f[n], g[n]);\n    }\n};",
