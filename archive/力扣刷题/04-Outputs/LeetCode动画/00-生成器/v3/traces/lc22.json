  "code": {
    "language": "cpp",
    "text": "class Solution {\npublic:\n\n    vector<string> ans;\n\n    vector<string> generateParenthesis(int n) {\n        dfs(n, 0, 0, \"\");\n        return ans;\n    }\n\n    void dfs(int n, int lc, int rc, string seq) {                // 深度优先搜索\n        if (lc == n && rc == n) ans.push_back(seq);              // 记录结果\n        else {\n            if (lc < n) dfs(n, lc + 1, rc, seq + '(');\n            if (rc < n && lc > rc) dfs(n, lc, rc + 1, seq + ')');\n        }\n    }\n};",
