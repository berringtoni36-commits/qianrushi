  "code": {
    "language": "cpp",
    "text": "class Solution {\npublic:\n    int jump(vector<int>& nums) {\n        int n = nums.size();\n        vector<int> f(n);\n\n        for (int i = 1, j = 0; i < n; i ++ ) {\n            while (j + nums[j] < i) j ++ ;\n            f[i] = f[j] + 1;\n        }\n\n        return f[n - 1];\n    }\n};",
