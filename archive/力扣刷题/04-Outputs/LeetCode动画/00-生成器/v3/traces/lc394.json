  "code": {
    "language": "cpp",
    "text": "class Solution {\npublic:\n    string decodeString(string s) {\n        int u = 0;\n        return dfs(s, u);\n    }\n\n    string dfs(string& s, int& u) {\n        string res;\n        while (u < s.size() && s[u] != ']') {\n            if (s[u] >= 'a' && s[u] <= 'z' || s[u] >= 'A' && s[u] <= 'Z') res += s[u ++ ];\n            else if (s[u] >= '0' && s[u] <= '9') {\n                int k = u;\n                while (s[k] >= '0' && s[k] <= '9') k ++ ;\n                int x = stoi(s.substr(u, k - u));\n                u = k + 1;\n                string y = dfs(s, u);\n                u ++ ; // 过滤掉右括号\n                while (x -- ) res += y;\n            }\n        }\n        return res;\n    }\n};",
