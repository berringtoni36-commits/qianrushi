  "code": {
    "language": "cpp",
    "text": "class Solution {\npublic:\n    bool canPartition(vector<int>& nums) {\n        int n = nums.size(), m = 0;\n        for (auto x: nums) m += x;\n        if (m % 2) return false;\n        m /= 2;\n        vector<int> f(m + 1);\n        f[0] = 1;\n        for (auto x: nums)\n            for (int j = m; j >= x; j -- )\n                f[j] |= f[j - x];\n        return f[m];\n    }\n};",
