  "code": {
    "language": "cpp",
    "text": "class Solution {\npublic:\n    int minDistance(string a, string b) {\n        int n = a.size(), m = b.size();\n        a = ' ' + a, b = ' ' + b;\n        vector<vector<int>> f(n + 1, vector<int>(m + 1));\n\n        for (int i = 0; i <= n; i ++ ) f[i][0] = i;\n        for (int i = 1; i <= m; i ++ ) f[0][i] = i;\n\n        for (int i = 1; i <= n; i ++ )\n            for (int j = 1; j <= m; j ++ ) {\n                f[i][j] = min(f[i - 1][j], f[i][j - 1]) + 1;\n                int t = a[i] != b[j];\n                f[i][j] = min(f[i][j], f[i - 1][j - 1] + t);\n            }\n\n        return f[n][m];\n    }\n};",
