  "code": {
    "language": "cpp",
    "text": "class Solution {\npublic:\n    int longestCommonSubsequence(string a, string b) {\n        int n = a.size(), m = b.size();\n        vector<vector<int>> f(n + 1, vector<int>(m + 1));\n        for (int i = 1; i <= n; i ++ )\n            for (int j = 1; j <= m; j ++ ) {\n                f[i][j] = max(f[i - 1][j], f[i][j - 1]);\n                if (a[i - 1] == b[j - 1])\n                    f[i][j] = max(f[i][j], f[i - 1][j - 1] + 1);\n            }\n        return f[n][m];\n    }\n};",
