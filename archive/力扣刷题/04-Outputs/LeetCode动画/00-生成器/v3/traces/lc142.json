      {
        "id": "L5",
        "sourceLine": 1414,
        "text": " *     ListNode *next;"
      },
      {
        "id": "L6",
        "sourceLine": 1415,
        "text": " *     ListNode(int x) : val(x), next(NULL) {}"
      },
      {
        "id": "L7",
        "sourceLine": 1416,
        "text": " * };"
      },
      {
        "id": "L8",
        "sourceLine": 1417,
        "text": " */"
      },
      {
        "id": "L9",
        "sourceLine": 1418,
        "text": "class Solution {"
      },
      {
        "id": "L10",
        "sourceLine": 1419,
        "text": "public:"
      },
      {
        "id": "L11",
        "sourceLine": 1420,
        "text": "    ListNode *detectCycle(ListNode *head) {"
      },
      {
        "id": "L12",
        "sourceLine": 1421,
        "text": "        if (!head || !head->next) return NULL;"
      },
      {
        "id": "L13",
        "sourceLine": 1422,
        "text": "        auto s = head, f = head->next;                           "
      },
      {
        "id": "L14",
        "sourceLine": 1423,
        "text": "        while (f) {"
      },
      {
        "id": "L15",
        "sourceLine": 1424,
        "text": "            s = s->next, f = f->next;                            "
      },
      {
        "id": "L16",
        "sourceLine": 1425,
        "text": "            if (!f) return NULL;"
      },
      {
        "id": "L17",
        "sourceLine": 1426,
        "text": "            f = f->next;                                         "
      },
      {
        "id": "L18",
        "sourceLine": 1427,
        "text": "            if (s == f) {"
      },
      {
        "id": "L19",
        "sourceLine": 1428,
        "text": "                s = head, f = f->next;                           "
      },
      {
        "id": "L20",
        "sourceLine": 1429,
        "text": "                while (s != f) s = s->next, f = f->next;         "
      },
      {
        "id": "L21",
        "sourceLine": 1430,
        "text": "                return s;"
      },
      {
        "id": "L22",
        "sourceLine": 1431,
        "text": "            }"
      },
      {
        "id": "L23",
        "sourceLine": 1432,
        "text": "        }"
      },
      {
        "id": "L24",
        "sourceLine": 1433,
        "text": "        return NULL;"
      },
      {
        "id": "L25",
        "sourceLine": 1434,
        "text": "    }"
      },
      {
        "id": "L26",
        "sourceLine": 1435,
        "text": "};"
      }
    ]
  }
