  "code": {
    "language": "cpp",
    "text": "/**\n * Definition for singly-linked list.\n * struct ListNode {\n *     int val;\n *     ListNode *next;\n *     ListNode(int x) : val(x), next(NULL) {}\n * };\n */\nclass Solution {\npublic:\n    ListNode *detectCycle(ListNode *head) {\n        if (!head || !head->next) return NULL;\n        auto s = head, f = head->next;                           \n        while (f) {\n            s = s->next, f = f->next;                            \n            if (!f) return NULL;\n            f = f->next;                                         \n            if (s == f) {\n                s = head, f = f->next;                           \n                while (s != f) s = s->next, f = f->next;         \n                return s;\n            }\n        }\n        return NULL;\n    }\n};",
    "lines": [
      {
        "id": "L1",
        "sourceLine": 1410,
        "text": "/**"
      },
