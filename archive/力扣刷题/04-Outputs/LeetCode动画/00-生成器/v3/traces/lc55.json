  "code": {
    "language": "cpp",
    "text": "class Solution {\npublic:\n    bool canJump(vector<int>& nums) {\n        for (int i = 0, j = 0; i < nums.size(); i ++ ) {\n            if (j < i) return false;\n            j = max(j, i + nums[i]);\n        }\n        return true;\n    }\n};",
