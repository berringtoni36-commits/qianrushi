  "code": {
    "language": "cpp",
    "text": "class Solution {\npublic:\n    int coinChange(vector<int>& coins, int m) {\n        vector<int> f(m + 1, 1e8);\n        f[0] = 0;\n        for (auto v: coins)\n            for (int j = v; j <= m; j ++ )\n                f[j] = min(f[j], f[j - v] + 1);\n        if (f[m] == 1e8) return -1;\n        return f[m];\n    }\n};",
