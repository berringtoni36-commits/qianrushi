  "code": {
    "language": "cpp",
    "text": "class Solution {\npublic:\n    int maxProfit(vector<int>& prices) {\n        int res = 0;\n        for (int i = 0, minp = INT_MAX; i < prices.size(); i ++ ) {  // 初始化为最大可能值\n            res = max(res, prices[i] - minp);\n            minp = min(minp, prices[i]);\n        }\n        return res;\n    }\n};",
