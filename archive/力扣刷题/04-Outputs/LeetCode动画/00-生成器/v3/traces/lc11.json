  "code": {
    "language": "cpp",
    "text": "class Solution {\npublic:\n    int maxArea(vector<int>& height) {\n        int res = 0;\n        for (int i = 0, j = height.size() - 1; i < j;) {\n            res = max(res, min(height[i], height[j]) * (j - i));\n            if (height[i] > height[j]) j -- ;\n            else i ++ ;  // 当前值太小，排除当前行\n        }\n        return res;\n    }\n};",
