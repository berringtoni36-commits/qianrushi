  "code": {
    "language": "cpp",
    "text": "class Solution {\npublic:\n    bool isValid(string s) {\n        stack<char> stk;\n        unordered_map<char, char> pairs = {  // 右括号→左括号的映射\n            {')', '('}, {']', '['}, {'}', '{'}\n        };\n\n        for (auto c : s) {\n            if (!pairs.count(c)) {  // 左括号，入栈\n                stk.push(c);                                     // 入栈\n            } else {  // 右括号，检查栈顶是否匹配\n                if (stk.size() && stk.top() == pairs[c])\n                    stk.pop();                                   // 出栈\n                else\n                    return false;\n            }\n        }\n\n        return stk.empty();  // 栈空说明所有括号都闭合了\n    }\n};",
