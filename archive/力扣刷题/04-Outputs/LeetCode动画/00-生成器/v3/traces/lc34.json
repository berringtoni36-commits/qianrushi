  "code": {
    "language": "cpp",
    "text": "class Solution {\npublic:\n    vector<int> searchRange(vector<int>& nums, int target) {\n        if (nums.empty()) return {-1, -1};\n\n        int l = 0, r = nums.size() - 1;\n        while (l < r) {\n            int mid = l + r >> 1;\n            if (nums[mid] >= target) r = mid;\n            else l = mid + 1;\n        }\n\n        if (nums[r] != target) return {-1, -1};\n\n        int L = r;\n        l = 0, r = nums.size() - 1;\n        while (l < r) {\n            int mid = l + r + 1 >> 1;\n            if (nums[mid] <= target) l = mid;\n            else r = mid - 1;\n        }\n\n        return {L, r};\n    }\n};",
