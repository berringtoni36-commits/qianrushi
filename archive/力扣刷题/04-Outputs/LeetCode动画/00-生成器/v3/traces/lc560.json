  "code": {
    "language": "cpp",
    "text": "class Solution {\npublic:\n    int subarraySum(vector<int>& nums, int k) {\n        int n = nums.size();\n        vector<int> s(n + 1);\n        for (int i = 1; i <= n; i ++ ) s[i] = s[i - 1] + nums[i - 1];\n        unordered_map<int, int> hash;                            // 哈希表，O(1)查找\n        hash[0] = 1;\n        int res = 0;\n        for (int i = 1; i <= n; i ++ ) {\n            res += hash[s[i] - k];\n            hash[s[i]] ++ ;\n        }\n        return res;\n    }\n};",
