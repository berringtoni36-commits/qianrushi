    "language": "cpp",
    "text": "/**\n * Definition for singly-linked list.\n * struct ListNode {\n *     int val;\n *     ListNode *next;\n *     ListNode(int x) : val(x), next(NULL) {}\n * };\n */\nclass Solution {\npublic:\n    ListNode* swapPairs(ListNode* head) {\n        auto dummy = new ListNode(-1);\n        dummy->next = head;                                      \n        for (auto p = dummy; p->next && p->next->next;) {        \n            auto a = p->next, b = a->next;                       \n            p->next = b;                                         \n            a->next = b->next;                                   \n            b->next = a;                                         \n            p = a;\n        }\n\n        return dummy->next;\n    }\n};",
