  "code": {
    "language": "cpp",
    "text": "class Solution {\npublic:\n    int firstMissingPositive(vector<int>& nums) {\n        int n = nums.size();\n        if (!n) return 1;\n\n        for (auto& x : nums)\n            if (x != INT_MIN) x -- ;                             // 初始化为最小可能值\n\n        for (int i = 0; i < n; i ++ ) {                          // 遍历\n            while (nums[i] >= 0 && nums[i] < n && nums[i] != i && nums[i] != nums[nums[i]]) // 将元素放到正确位置（原地哈希）\n                swap(nums[i], nums[nums[i]]);                    // 交换\n        }\n\n        for (int i = 0; i < n; i ++ )                            // 遍历\n            if (nums[i] != i)\n                return i + 1;\n\n        return n + 1;\n    }\n};",
