  "code": {
    "language": "cpp",
    "text": "class Solution {\npublic:\n    vector<vector<int>> merge(vector<vector<int>>& a) {\n        vector<vector<int>> res;\n        if (a.empty()) return res;\n\n        sort(a.begin(), a.end());                                // 排序\n        int l = a[0][0], r = a[0][1];\n        for (int i = 1; i < a.size(); i ++ ) {\n            if (a[i][0] > r) {\n                res.push_back({l, r});                           // 记录结果\n                l = a[i][0], r = a[i][1];\n            } else r = max(r, a[i][1]);\n        }\n\n        res.push_back({l, r});                                   // 记录结果\n        return res;\n    }\n};",
