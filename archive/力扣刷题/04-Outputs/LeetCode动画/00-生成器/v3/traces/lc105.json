      {
        "id": "L9",
        "sourceLine": 2652,
        "text": " */"
      },
      {
        "id": "L10",
        "sourceLine": 2653,
        "text": "class Solution {"
      },
      {
        "id": "L11",
        "sourceLine": 2654,
        "text": "public:"
      },
      {
        "id": "L12",
        "sourceLine": 2655,
        "text": "    unordered_map<int, int> pos;                                 // 哈希表，O(1)查找"
      },
      {
        "id": "L13",
        "sourceLine": 2656,
        "text": ""
      },
      {
        "id": "L14",
        "sourceLine": 2657,
        "text": "    TreeNode* buildTree(vector<int>& preorder, vector<int>& inorder) {"
      },
      {
        "id": "L15",
        "sourceLine": 2658,
        "text": "        for (int i = 0; i < inorder.size(); i ++ ) pos[inorder[i]] = i;"
      },
      {
        "id": "L16",
        "sourceLine": 2659,
        "text": "        return build(preorder, inorder, 0, preorder.size() - 1, 0, inorder.size() - 1);"
      },
      {
        "id": "L17",
        "sourceLine": 2660,
        "text": "    }"
      },
      {
        "id": "L18",
        "sourceLine": 2661,
        "text": ""
      },
      {
        "id": "L19",
        "sourceLine": 2662,
        "text": "    TreeNode* build(vector<int>& preorder, vector<int>& inorder, int pl, int pr, int il, int ir) {"
      },
      {
        "id": "L20",
        "sourceLine": 2663,
        "text": "        if (pl > pr) return NULL;"
      },
      {
        "id": "L21",
        "sourceLine": 2664,
        "text": "        auto root = new TreeNode(preorder[pl]);"
      },
      {
        "id": "L22",
        "sourceLine": 2665,
        "text": "        int k = pos[root->val];"
      },
      {
        "id": "L23",
        "sourceLine": 2666,
        "text": "        root->left = build(preorder, inorder, pl + 1, pl + 1 + k - 1 - il, il, k - 1);"
      },
      {
        "id": "L24",
        "sourceLine": 2667,
        "text": "        root->right = build(preorder, inorder, pl + 1 + k - 1 - il + 1, pr, k + 1, ir);"
      },
      {
        "id": "L25",
        "sourceLine": 2668,
        "text": "        return root;"
      },
      {
        "id": "L26",
        "sourceLine": 2669,
        "text": "    }"
      },
      {
        "id": "L27",
        "sourceLine": 2670,
        "text": "};"
