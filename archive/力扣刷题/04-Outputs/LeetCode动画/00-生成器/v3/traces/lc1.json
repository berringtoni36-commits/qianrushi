  "code": {
    "language": "cpp",
    "text": "class Solution {\npublic:\n    vector<int> twoSum(vector<int>& nums, int target) {\n        unordered_map<int, int> heap;                            // 哈希表，O(1)查找\n        for (int i = 0; i < nums.size(); i ++ ) {                // 遍历\n            int r = target - nums[i];\n            if (heap.count(r)) return {heap[r], i};              // 查找是否在哈希表中\n            heap[nums[i]] = i;\n        }\n\n        return {};\n    }\n};",
