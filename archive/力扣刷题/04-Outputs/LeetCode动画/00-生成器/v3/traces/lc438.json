  "code": {
    "language": "cpp",
    "text": "class Solution {\npublic:\n    vector<int> findAnagrams(string s, string p) {\n        unordered_map<char, int> cnt;                            // 哈希表，O(1)查找\n        for (auto c: p) cnt[c] ++ ;\n        vector<int> res;\n        int tot = cnt.size();\n        for (int i = 0, j = 0, satisfy = 0; i < s.size(); i ++ ) {\n            if ( -- cnt[s[i]] == 0) satisfy ++ ;\n            while (i - j + 1 > p.size()) {\n                if (cnt[s[j]] == 0) satisfy -- ;\n                cnt[s[j ++ ]] ++ ;\n            }\n            if (satisfy == tot) res.push_back(j);                // 记录结果\n        }\n        return res;\n    }\n};",
