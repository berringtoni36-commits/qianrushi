  "code": {
    "language": "cpp",
    "text": "class Solution {\npublic:\n    int longestValidParentheses(string s) {\n        stack<int> stk;\n\n        int res = 0;\n        for (int i = 0, start = -1; i < s.size(); i ++ ) {\n            if (s[i] == '(') stk.push(i);                        // 入栈\n            else {\n                if (stk.size()) {\n                    stk.pop();                                   // 出栈\n                    if (stk.size()) {\n                        res = max(res, i - stk.top());\n                    } else {\n                        res = max(res, i - start);\n                    }\n                } else {\n                    start = i;\n                }\n            }\n        }\n\n        return res;\n    }\n};",
