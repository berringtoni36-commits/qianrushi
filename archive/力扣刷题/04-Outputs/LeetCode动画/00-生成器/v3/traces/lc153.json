  "code": {
    "language": "cpp",
    "text": "class Solution {\npublic:\n    int findMin(vector<int>& nums) {\n        int l = 0, r = nums.size() - 1;\n        if (nums[r] >= nums[l]) return nums[0];\n        while (l < r) {\n            int mid = l + r >> 1;\n            if (nums[mid] < nums[0]) r = mid;\n            else l = mid + 1;\n        }\n        return nums[r];\n    }\n};",
