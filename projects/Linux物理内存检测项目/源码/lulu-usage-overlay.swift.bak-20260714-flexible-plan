        self.onEdit = onEdit
        self.onDelete = onDelete
        super.init(frame: .zero)

        checkbox.state = item.completed ? .on : .off
        checkbox.target = self
        checkbox.action = #selector(toggleTask)

        textField.delegate = self
        textField.isBordered = false
        textField.drawsBackground = false
        textField.focusRingType = .none
        textField.font = .systemFont(ofSize: 13)
        textField.maximumNumberOfLines = 0
        textField.lineBreakMode = .byWordWrapping
        textField.cell?.wraps = true
        textField.cell?.isScrollable = false
        textField.cell?.usesSingleLineMode = false
        applyTextStyle(completed: item.completed)

        wantsLayer = true
        layer?.cornerRadius = 9
        layer?.backgroundColor = NSColor.controlBackgroundColor.withAlphaComponent(0.12).cgColor

        deleteButton.target = self
        deleteButton.action = #selector(deleteTask)
