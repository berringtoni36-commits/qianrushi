        refreshButton.frame = NSRect(x: bounds.width - 86, y: y - 2, width: 82, height: 25)
        y += 28
        ankiStatus.frame = NSRect(x: 4, y: y, width: bounds.width - 8, height: 30)
        y += 31
        for row in ankiRows {
            row.frame = NSRect(x: 0, y: y, width: bounds.width, height: 47)
