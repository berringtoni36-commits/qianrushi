        deleteButton.font = .systemFont(ofSize: 17, weight: .medium)
        deleteButton.contentTintColor = .secondaryLabelColor

        addSubview(checkbox)
        addSubview(textField)
        addSubview(deleteButton)
    }

    required init?(coder: NSCoder) { nil }

    override func layout() {
        super.layout()
        checkbox.frame = NSRect(x: 4, y: 8, width: 22, height: 22)
        deleteButton.frame = NSRect(x: bounds.width - 30, y: 6, width: 26, height: 26)
        textField.frame = NSRect(x: 30, y: 7, width: bounds.width - 64, height: max(24, bounds.height - 14))
    }

    func preferredHeight(for width: CGFloat) -> CGFloat {
        let availableWidth = max(80, width - 64)
        let textBounds = textField.attributedStringValue.boundingRect(
            with: NSSize(width: availableWidth, height: .greatestFiniteMagnitude),
            options: [.usesLineFragmentOrigin, .usesFontLeading]
        )
        return max(40, ceil(textBounds.height) + 16)
    }

    private func applyTextStyle(completed: Bool) {
        let attributes: [NSAttributedString.Key: Any] = [
            .font: NSFont.systemFont(ofSize: 13),
            .foregroundColor: completed ? NSColor.secondaryLabelColor : NSColor.labelColor,
            .strikethroughStyle: completed ? NSUnderlineStyle.single.rawValue : 0
        ]
        textField.attributedStringValue = NSAttributedString(string: textField.stringValue, attributes: attributes)
    }

    @objc private func toggleTask() {
        let completed = checkbox.state == .on
        applyTextStyle(completed: completed)
        onToggle(itemID, completed)
    }

    @objc private func deleteTask() {
        onDelete(itemID)
    }

    func controlTextDidEndEditing(_ obj: Notification) {
        onEdit(itemID, textField.stringValue)
    }
}

