private final class FocusTimerView: FlippedView, NSTextFieldDelegate {
    private let store: TodoStore
    private let timerModeControl = NSSegmentedControl(labels: ["正计时", "倒计时"], trackingMode: .selectOne, target: nil, action: nil)
    private let durationLabel = NSTextField(labelWithString: "专注时长")
    private let durationField = NSTextField(string: "25")
    private let minuteLabel = NSTextField(labelWithString: "分钟")
    private let timerLabel = NSTextField(labelWithString: "25:00")
    private let progressBar = NSProgressIndicator()
    private let statusLabel = NSTextField(labelWithString: "准备好后，开始一次安静的专注")
    private let startButton = NSButton(title: "开始专注", target: nil, action: nil)
    private let finishButton = NSButton(title: "结束", target: nil, action: nil)
    private let resetButton = NSButton(title: "重置", target: nil, action: nil)
    private let statsTitle = NSTextField(labelWithString: "专注记录")
    private let statsLabel = NSTextField(wrappingLabelWithString: "")
    private var timer: Timer?
    private var isCountUp: Bool
    private var durationMinutes: Int
    private var remainingSeconds: Int
    private var focusedSeconds = 0
    private var isRunning = false {
        didSet {
            if oldValue != isRunning { onRunningChanged?(isRunning) }
        }
    }
    private var sessionStartedAt: Date?
    var onRunningChanged: ((Bool) -> Void)?

    init(store: TodoStore) {
        self.store = store
        isCountUp = settingsStore.value.timerMode == "countUp"
        durationMinutes = settingsStore.value.countdownMinutes
        remainingSeconds = durationMinutes * 60
        super.init(frame: .zero)

        timerModeControl.selectedSegment = isCountUp ? 0 : 1
        timerModeControl.target = self
        timerModeControl.action = #selector(switchTimerMode)
        durationLabel.font = .systemFont(ofSize: 12, weight: .medium)
        durationField.stringValue = "\(durationMinutes)"
        durationField.alignment = .center
        durationField.font = .monospacedDigitSystemFont(ofSize: 13, weight: .semibold)
        durationField.delegate = self
        minuteLabel.font = .systemFont(ofSize: 12)
        minuteLabel.textColor = .secondaryLabelColor

        timerLabel.font = .monospacedDigitSystemFont(ofSize: 48, weight: .medium)
        timerLabel.alignment = .center
        timerLabel.textColor = .labelColor

        progressBar.style = .bar
        progressBar.isIndeterminate = false
        progressBar.minValue = 0
        progressBar.maxValue = Double(durationMinutes * 60)
        progressBar.doubleValue = 0

        statusLabel.font = .systemFont(ofSize: 11.5)
        statusLabel.textColor = .secondaryLabelColor
        statusLabel.alignment = .center

        startButton.target = self
        startButton.action = #selector(toggleTimer)
        startButton.bezelStyle = .rounded
        startButton.keyEquivalent = "\r"
        finishButton.target = self
        finishButton.action = #selector(finishAndRecord)
        finishButton.bezelStyle = .rounded
        finishButton.isEnabled = false
        resetButton.target = self
        resetButton.action = #selector(resetTimer)
        resetButton.bezelStyle = .rounded

        statsTitle.font = .systemFont(ofSize: 13, weight: .semibold)
        statsLabel.font = .systemFont(ofSize: 12.5)
        statsLabel.textColor = .secondaryLabelColor
        statsLabel.maximumNumberOfLines = 3

        [timerModeControl, durationLabel, durationField, minuteLabel, timerLabel, progressBar, statusLabel,
         startButton, finishButton, resetButton, statsTitle, statsLabel].forEach(addSubview)
        refreshDisplay()
    }

    required init?(coder: NSCoder) { nil }

    deinit { timer?.invalidate() }

    override func draw(_ dirtyRect: NSRect) {
        super.draw(dirtyRect)
        let timerCard = NSBezierPath(roundedRect: NSRect(x: 0.5, y: 38.5, width: bounds.width - 1, height: 205), xRadius: 14, yRadius: 14)
        NSColor.controlBackgroundColor.withAlphaComponent(0.48).setFill()
        timerCard.fill()
        NSColor.separatorColor.withAlphaComponent(0.5).setStroke()
        timerCard.lineWidth = 1
        timerCard.stroke()

        let statsCard = NSBezierPath(roundedRect: NSRect(x: 0.5, y: 256.5, width: bounds.width - 1, height: 92), xRadius: 12, yRadius: 12)
        NSColor.controlBackgroundColor.withAlphaComponent(0.34).setFill()
        statsCard.fill()
    }

    override func layout() {
        super.layout()
        let width = bounds.width
        timerModeControl.frame = NSRect(x: 18, y: 6, width: 128, height: 28)
        durationLabel.frame = NSRect(x: 164, y: 10, width: 52, height: 22)
        durationField.frame = NSRect(x: 220, y: 6, width: 54, height: 28)
        minuteLabel.frame = NSRect(x: 280, y: 10, width: 42, height: 22)
        timerLabel.frame = NSRect(x: 18, y: 58, width: width - 36, height: 66)
        progressBar.frame = NSRect(x: 24, y: 133, width: width - 48, height: 6)
        statusLabel.frame = NSRect(x: 18, y: 151, width: width - 36, height: 20)

        let buttonsWidth = min(width - 36, 302)
        let startX = (width - buttonsWidth) / 2
        startButton.frame = NSRect(x: startX, y: 188, width: 104, height: 32)
        finishButton.frame = NSRect(x: startX + 110, y: 188, width: 112, height: 32)
        resetButton.frame = NSRect(x: startX + 228, y: 188, width: 74, height: 32)

        statsTitle.frame = NSRect(x: 17, y: 270, width: width - 34, height: 20)
        statsLabel.frame = NSRect(x: 17, y: 297, width: width - 34, height: 42)
    }

    func refreshStats() {
        let stats = store.focusStats
        statsLabel.stringValue = "今天  \(durationText(stats.todaySeconds))\n近 7 天  \(durationText(stats.recentSeconds))  ·  \(stats.recentSessions) 次专注"
    }

    private func refreshDisplay(message: String? = nil) {
        let displaySeconds = isCountUp ? focusedSeconds : remainingSeconds
        let minutes = displaySeconds / 60
        let seconds = displaySeconds % 60
        timerLabel.stringValue = String(format: "%02d:%02d", minutes, seconds)
        progressBar.maxValue = Double(durationMinutes * 60)
        progressBar.doubleValue = Double(isCountUp ? focusedSeconds : durationMinutes * 60 - remainingSeconds)
        startButton.title = isRunning ? "暂停" : (focusedSeconds > 0 ? "继续专注" : "开始专注")
        finishButton.isEnabled = focusedSeconds > 0
        durationLabel.isHidden = isCountUp
        durationField.isHidden = isCountUp
        minuteLabel.isHidden = isCountUp
        durationField.isEnabled = !isRunning && focusedSeconds == 0 && !isCountUp
        if let message {
            statusLabel.stringValue = message
        } else if isRunning {
            statusLabel.stringValue = isCountUp
                ? "正计时中 · 暂停时不会计入学习时间"
                : "倒计时中 · 暂停时不会计入学习时间"
        } else if focusedSeconds > 0 {
            statusLabel.stringValue = "已专注 \(durationText(focusedSeconds))，可以继续或结束记录"
        } else {
            statusLabel.stringValue = "准备好后，开始一次安静的专注"
        }
        refreshStats()
    }

    private func applyDuration() {
        let value = Int(durationField.stringValue) ?? durationMinutes
        durationMinutes = max(1, min(180, value))
        durationField.stringValue = "\(durationMinutes)"
        remainingSeconds = isCountUp ? 0 : durationMinutes * 60
        settingsStore.update { $0.countdownMinutes = durationMinutes }
        refreshDisplay()
    }

    @objc private func toggleTimer() {
        if isRunning {
            isRunning = false
            timer?.invalidate()
            timer = nil
            refreshDisplay(message: "已暂停 · 当前专注 \(durationText(focusedSeconds))")
            return
        }
        if focusedSeconds == 0 && !isCountUp { applyDuration() }
        if sessionStartedAt == nil { sessionStartedAt = Date() }
        isRunning = true
        timer = Timer.scheduledTimer(withTimeInterval: 1, repeats: true) { [weak self] _ in
            self?.tick()
        }
        refreshDisplay()
    }

    private func tick() {
        guard isRunning else { return }
        focusedSeconds += 1
        if !isCountUp {
            remainingSeconds = max(0, remainingSeconds - 1)
        }
        if !isCountUp && remainingSeconds == 0 {
            completeTimer()
        } else {
            refreshDisplay()
        }
    }

    private func completeTimer() {
        timer?.invalidate()
        timer = nil
        isRunning = false
        let recorded = focusedSeconds
        if recorded >= minimumFocusRecordSeconds {
            store.addFocusSession(startedAt: sessionStartedAt ?? Date(), durationSeconds: recorded)
        }
        focusedSeconds = 0
        sessionStartedAt = nil
        remainingSeconds = durationMinutes * 60
        NSSound.beep()
        refreshDisplay(message: recorded >= minimumFocusRecordSeconds
            ? "完成一次专注，已记录 \(durationText(recorded)) ✓"
            : "不足 5 分钟，本次不记入学习记录")
    }

    @objc private func finishAndRecord() {
        guard focusedSeconds > 0 else { return }
        timer?.invalidate()
        timer = nil
        isRunning = false
        let recorded = focusedSeconds
        if recorded >= minimumFocusRecordSeconds {
            store.addFocusSession(startedAt: sessionStartedAt ?? Date(), durationSeconds: recorded)
        }
        focusedSeconds = 0
        sessionStartedAt = nil
        remainingSeconds = durationMinutes * 60
        refreshDisplay(message: recorded >= minimumFocusRecordSeconds
            ? "本次学习已记录：\(durationText(recorded))"
            : "不足 5 分钟，本次不记入学习记录")
    }

    @objc private func resetTimer() {
        timer?.invalidate()
        timer = nil
        isRunning = false
        focusedSeconds = 0
        sessionStartedAt = nil
        applyDuration()
        refreshDisplay(message: "计时器已重置")
    }

    @objc private func switchTimerMode() {
        guard !isRunning && focusedSeconds == 0 else {
            timerModeControl.selectedSegment = isCountUp ? 0 : 1
            return
        }
        isCountUp = timerModeControl.selectedSegment == 0
        settingsStore.update { $0.timerMode = isCountUp ? "countUp" : "countDown" }
        remainingSeconds = isCountUp ? 0 : durationMinutes * 60
        refreshDisplay(message: isCountUp ? "正计时已准备好，想学多久就学多久" : "倒计时已准备好")
    }

    func startCountUp() {
        guard !isRunning else { return }
        if focusedSeconds == 0 {
            isCountUp = true
            timerModeControl.selectedSegment = 0
            settingsStore.update { $0.timerMode = "countUp" }
            remainingSeconds = 0
        }
        guard isCountUp else { return }
        toggleTimer()
    }

    func toggleCountUpFromBadge() {
        if isRunning {
            timer?.invalidate()
            timer = nil
            isRunning = false
            let recorded = focusedSeconds
            if recorded >= minimumFocusRecordSeconds {
                store.addFocusSession(startedAt: sessionStartedAt ?? Date(), durationSeconds: recorded)
            }
            focusedSeconds = 0
            sessionStartedAt = nil
            remainingSeconds = durationMinutes * 60
            refreshDisplay(message: recorded >= minimumFocusRecordSeconds ? "本次学习已记录" : "不足 5 分钟，本次不记录")
        } else {
            startCountUp()
        }
    }

    func controlTextDidEndEditing(_ obj: Notification) {
        guard focusedSeconds == 0 && !isRunning else { return }
        applyDuration()
    }
}

