private struct LuluSettings: Codable {
    var schemaVersion = 1
    var timerMode = "countUp"
    var countdownMinutes = 50
    var minimumRecordMinutes = 5
    var usageRefreshSeconds = 60.0
    var badgeWidth = 184.0
    var badgeHeight = 58.0
    var badgeVisible = true
}

private final class SettingsStore {
    static let shared = SettingsStore()
    private(set) var value: LuluSettings
    private let url = URL(fileURLWithPath: settingsPath)

    private init() {
        let decoder = JSONDecoder()
        if let data = try? Data(contentsOf: url),
           let decoded = try? decoder.decode(LuluSettings.self, from: data) {
            value = decoded
        } else {
            var migrated = LuluSettings()
            let defaults = UserDefaults.standard
            if defaults.object(forKey: "lulu.focusTimerMode") != nil {
                migrated.timerMode = defaults.integer(forKey: "lulu.focusTimerMode") == 1 ? "countUp" : "countDown"
            }
            let minutes = defaults.integer(forKey: "lulu.focusDurationMinutes")
            if minutes > 0 { migrated.countdownMinutes = minutes }
            value = migrated
            save()
        }
        value.countdownMinutes = max(1, min(180, value.countdownMinutes))
        value.minimumRecordMinutes = max(1, value.minimumRecordMinutes)
        value.usageRefreshSeconds = max(15, value.usageRefreshSeconds)
        value.badgeWidth = max(160, value.badgeWidth)
        value.badgeHeight = max(52, value.badgeHeight)
    }

    func update(_ change: (inout LuluSettings) -> Void) {
        change(&value)
        save()
    }

    private func save() {
        let encoder = JSONEncoder()
        encoder.outputFormatting = [.prettyPrinted, .sortedKeys]
        guard let data = try? encoder.encode(value) else { return }
        try? FileManager.default.createDirectory(at: url.deletingLastPathComponent(), withIntermediateDirectories: true)
        try? data.write(to: url, options: .atomic)
    }
}

private let settingsStore = SettingsStore.shared
private var minimumFocusRecordSeconds: Int { settingsStore.value.minimumRecordMinutes * 60 }

private func findCodexExecutable() -> String {
    if let configured = ProcessInfo.processInfo.environment["LULU_CODEX_PATH"],
       !configured.isEmpty,
       FileManager.default.isExecutableFile(atPath: configured) {
        return configured
    }
    let candidates = [
        "\(userHome)/.local/bin/codex",
        "\(userHome)/.local/node-v22.16.0-darwin-arm64/bin/codex",
        "/opt/homebrew/bin/codex",
        "/usr/local/bin/codex"
    ]
    if let match = candidates.first(where: { FileManager.default.isExecutableFile(atPath: $0) }) {
        return match
    }
    return "codex"
}

private let codexPath = findCodexExecutable()

private func jsonLine(_ value: Any) -> String? {
    guard JSONSerialization.isValidJSONObject(value),
          let data = try? JSONSerialization.data(withJSONObject: value),
          let text = String(data: data, encoding: .utf8) else { return nil }
    return text + "\n"
}

private func number(_ value: Any?) -> Double? {
    if let value = value as? NSNumber { return value.doubleValue }
    if let value = value as? String { return Double(value) }
    return nil
}

private func point(_ dictionary: [String: Any], _ key: String) -> CGFloat? {
    guard let value = number(dictionary[key]) else { return nil }
    return CGFloat(value)
}

private func durationText(_ seconds: Int) -> String {
    let minutes = max(0, seconds) / 60
    if minutes < 60 { return "\(minutes) 分钟" }
    let hours = minutes / 60
    let rest = minutes % 60
    return rest == 0 ? "\(hours) 小时" : "\(hours) 小时 \(rest) 分"
}

private enum TaskCategory: String, Codable, CaseIterable {
    case linuxVisual
    case rtos
    case linuxPhysical
    case anki
    case general
}

private struct TodoItem: Codable {
    let id: UUID
    var text: String
    var completed: Bool
    let createdAt: Date
    var categories: [TaskCategory]

    private enum CodingKeys: String, CodingKey {
        case id, text, completed, createdAt, categories
    }

    init(id: UUID, text: String, completed: Bool, createdAt: Date, categories: [TaskCategory]) {
        self.id = id
        self.text = text
        self.completed = completed
        self.createdAt = createdAt
        self.categories = categories
    }

    init(from decoder: Decoder) throws {
        let container = try decoder.container(keyedBy: CodingKeys.self)
        id = try container.decode(UUID.self, forKey: .id)
        text = try container.decode(String.self, forKey: .text)
        completed = try container.decode(Bool.self, forKey: .completed)
        createdAt = try container.decode(Date.self, forKey: .createdAt)
        categories = try container.decodeIfPresent([TaskCategory].self, forKey: .categories) ?? []
    }
}

private struct PlanDay: Codable {
    var dayNumber: Int
    var title: String
    var tasks: [TodoItem]
}

private struct CompletionRecord: Codable {
    let id: UUID
    var text: String
    let completedAt: Date
    let dayKey: String
}

private struct FocusSession: Codable {
    let id: UUID
    let startedAt: Date
    let endedAt: Date
    let durationSeconds: Int
    let dayKey: String
}

private struct AnkiDeckProgress: Codable {
    var learned: Int
    var total: Int
    var updatedAt: Date

    var percent: Int {
        guard total > 0 else { return 0 }
        return max(0, min(100, Int((Double(learned) / Double(total) * 100).rounded())))
    }
}

private struct TodoArchive: Codable {
    var schemaVersion = 2
    var planDays: [PlanDay] = []
    var currentStudyDay = 1
    var startDate = "2026-07-14"
    var targetDate = "2026-08-24"
    var ankiProgressCache: [String: AnkiDeckProgress] = [:]
    var completions: [CompletionRecord] = []
    var focusSessions: [FocusSession] = []

    private enum CodingKeys: String, CodingKey {
        case schemaVersion, planDays, currentStudyDay, startDate, targetDate
        case ankiProgressCache, completions, focusSessions, days
    }

    init() {}

    init(from decoder: Decoder) throws {
        let container = try decoder.container(keyedBy: CodingKeys.self)
        schemaVersion = try container.decodeIfPresent(Int.self, forKey: .schemaVersion) ?? 1
        planDays = try container.decodeIfPresent([PlanDay].self, forKey: .planDays) ?? []
        currentStudyDay = try container.decodeIfPresent(Int.self, forKey: .currentStudyDay) ?? 1
        startDate = try container.decodeIfPresent(String.self, forKey: .startDate) ?? "2026-07-14"
        targetDate = try container.decodeIfPresent(String.self, forKey: .targetDate) ?? "2026-08-24"
        ankiProgressCache = try container.decodeIfPresent([String: AnkiDeckProgress].self, forKey: .ankiProgressCache) ?? [:]
        completions = try container.decodeIfPresent([CompletionRecord].self, forKey: .completions) ?? []
        focusSessions = try container.decodeIfPresent([FocusSession].self, forKey: .focusSessions) ?? []

        if planDays.isEmpty,
           let legacyDays = try container.decodeIfPresent([String: [TodoItem]].self, forKey: .days) {
            planDays = legacyDays.keys.sorted().enumerated().map { offset, key in
                let dayNumber = offset + 1
                return PlanDay(
                    dayNumber: dayNumber,
                    title: TodoStore.theme(for: dayNumber),
                    tasks: legacyDays[key] ?? []
                )
            }
            currentStudyDay = planDays.first(where: { !$0.tasks.isEmpty && !$0.tasks.allSatisfy(\.completed) })?.dayNumber
                ?? max(1, planDays.last?.dayNumber ?? 1)
            schemaVersion = 2
        }
    }

    func encode(to encoder: Encoder) throws {
        var container = encoder.container(keyedBy: CodingKeys.self)
        try container.encode(schemaVersion, forKey: .schemaVersion)
        try container.encode(planDays, forKey: .planDays)
        try container.encode(currentStudyDay, forKey: .currentStudyDay)
        try container.encode(startDate, forKey: .startDate)
        try container.encode(targetDate, forKey: .targetDate)
        try container.encode(ankiProgressCache, forKey: .ankiProgressCache)
        try container.encode(completions, forKey: .completions)
        try container.encode(focusSessions, forKey: .focusSessions)
    }
}

private struct HistoryDay {
    let dayKey: String
    let records: [CompletionRecord]
    let focusSeconds: Int
    let focusCount: Int
}

private struct LearningStats {
    let recentCompleted: Int
    let activeDays: Int
    let streak: Int
}

private struct FocusStats {
    let todaySeconds: Int
    let recentSeconds: Int
    let recentSessions: Int
}

private struct ProjectProgress {
    let title: String
    let completed: Int
    let total: Int

    var percent: Int {
        guard total > 0 else { return 0 }
        return max(0, min(100, Int((Double(completed) / Double(total) * 100).rounded())))
    }
}

private struct DeadlineStatus {
    let remainingStudyDays: Int
    let remainingCalendarDays: Int
    let weeklyPace: Double
    let targetDateText: String
}

private final class TodoStore {
    private let url = URL(fileURLWithPath: todoPath)
    private var archive = TodoArchive()

    private(set) var ankiConnected = false
    private(set) var ankiLastAttempt: Date?
    private var ankiRefreshInFlight = false

    static let ankiDecks = ["嵌入式高频150", "Linux视觉", "rtos项目", "Linux物理"]

    init() { load() }

    private static let keyFormatter: DateFormatter = {
        let formatter = DateFormatter()
        formatter.locale = Locale(identifier: "en_US_POSIX")
        formatter.timeZone = .current
        formatter.dateFormat = "yyyy-MM-dd"
        return formatter
    }()

    static func dayKey(for date: Date = Date()) -> String {
        keyFormatter.string(from: date)
    }

    static func date(for dayKey: String) -> Date? {
        keyFormatter.date(from: dayKey)
    }

    var planDays: [PlanDay] {
        archive.planDays.sorted { $0.dayNumber < $1.dayNumber }
    }

    var currentStudyDay: Int {
        archive.currentStudyDay
    }

    var today: [TodoItem] {
        items(for: currentStudyDay)
    }

    func items(for studyDay: Int) -> [TodoItem] {
        archive.planDays.first(where: { $0.dayNumber == studyDay })?.tasks ?? []
    }

    func title(for studyDay: Int) -> String {
        archive.planDays.first(where: { $0.dayNumber == studyDay })?.title ?? Self.theme(for: studyDay)
    }

    var progress: (completed: Int, total: Int) {
        let items = today
        return (items.filter(\.completed).count, items.count)
    }

    var canAdvanceCurrentDay: Bool {
        let items = today
        return items.allSatisfy(\.completed) && currentStudyDay < (planDays.last?.dayNumber ?? 28)
    }

    var deadlineStatus: DeadlineStatus {
        let calendar = Calendar.current
        let today = calendar.startOfDay(for: Date())
        let target = Self.date(for: archive.targetDate) ?? today
        let remainingCalendarDays = max(0, (calendar.dateComponents([.day], from: today, to: target).day ?? 0) + 1)
        let remainingStudyDays = max(0, (planDays.last?.dayNumber ?? 28) - currentStudyDay + 1)
        let weeks = max(1.0 / 7.0, Double(remainingCalendarDays) / 7.0)
        return DeadlineStatus(
            remainingStudyDays: remainingStudyDays,
            remainingCalendarDays: remainingCalendarDays,
            weeklyPace: Double(remainingStudyDays) / weeks,
            targetDateText: archive.targetDate
        )
    }

    var projectProgress: [ProjectProgress] {
        let definitions: [(String, TaskCategory)] = [
            ("Linux视觉", .linuxVisual),
            ("RTOS", .rtos),
            ("Linux物理", .linuxPhysical)
        ]
        let allTasks = planDays.flatMap(\.tasks)
        return definitions.map { title, category in
            let tasks = allTasks.filter { $0.categories.contains(category) }
            return ProjectProgress(title: title, completed: tasks.filter(\.completed).count, total: tasks.count)
        }
    }

    var ankiProgress: [String: AnkiDeckProgress] { archive.ankiProgressCache }

    var history: [HistoryDay] {
        let grouped = Dictionary(grouping: archive.completions, by: \CompletionRecord.dayKey)
        let focusGrouped = Dictionary(grouping: archive.focusSessions, by: \FocusSession.dayKey)
        let keys = Set(grouped.keys).union(focusGrouped.keys)
        return keys.sorted(by: >).map { key in
            let sessions = focusGrouped[key] ?? []
            return HistoryDay(
                dayKey: key,
                records: (grouped[key] ?? []).sorted { $0.completedAt > $1.completedAt },
                focusSeconds: sessions.reduce(0) { $0 + $1.durationSeconds },
                focusCount: sessions.count
            )
        }
    }

    var learningStats: LearningStats {
        let calendar = Calendar.current
        let today = calendar.startOfDay(for: Date())
        let sevenDaysAgo = calendar.date(byAdding: .day, value: -6, to: today) ?? today
        let recentCompleted = archive.completions.filter { record in
            guard let date = Self.date(for: record.dayKey) else { return false }
            return date >= sevenDaysAgo && date <= today
        }.count
        let activeDayKeys = Set(archive.completions.map(\.dayKey))
            .union(archive.focusSessions.map(\.dayKey))

        var cursor = today
        if !activeDayKeys.contains(Self.dayKey(for: cursor)),
           let yesterday = calendar.date(byAdding: .day, value: -1, to: cursor),
           activeDayKeys.contains(Self.dayKey(for: yesterday)) {
            cursor = yesterday
        }
        var streak = 0
        while activeDayKeys.contains(Self.dayKey(for: cursor)) {
            streak += 1
            guard let previous = calendar.date(byAdding: .day, value: -1, to: cursor) else { break }
            cursor = previous
        }
        return LearningStats(
            recentCompleted: recentCompleted,
            activeDays: activeDayKeys.count,
            streak: streak
        )
    }

    var focusStats: FocusStats {
        let calendar = Calendar.current
        let today = calendar.startOfDay(for: Date())
        let sevenDaysAgo = calendar.date(byAdding: .day, value: -6, to: today) ?? today
        let todayKey = Self.dayKey()
        let recent = archive.focusSessions.filter { session in
            guard let date = Self.date(for: session.dayKey) else { return false }
            return date >= sevenDaysAgo && date <= today
        }
        return FocusStats(
            todaySeconds: archive.focusSessions.filter { $0.dayKey == todayKey }.reduce(0) { $0 + $1.durationSeconds },
            recentSeconds: recent.reduce(0) { $0 + $1.durationSeconds },
            recentSessions: recent.count
        )
    }

    func addFocusSession(startedAt: Date, durationSeconds: Int) {
        guard durationSeconds >= minimumFocusRecordSeconds else { return }
        let endedAt = Date()
        archive.focusSessions.append(FocusSession(
            id: UUID(),
            startedAt: startedAt,
            endedAt: endedAt,
            durationSeconds: durationSeconds,
            dayKey: Self.dayKey(for: endedAt)
        ))
        save()
    }

    func add(_ rawText: String, to studyDay: Int? = nil) {
        let text = rawText.trimmingCharacters(in: .whitespacesAndNewlines)
        guard !text.isEmpty else { return }
        let day = studyDay ?? currentStudyDay
        var items = items(for: day)
        items.append(TodoItem(
            id: UUID(),
            text: text,
            completed: false,
            createdAt: Date(),
            categories: Self.categories(for: day, text: text)
        ))
        set(items, for: day)
    }

    func setCompleted(id: UUID, completed: Bool, studyDay: Int? = nil) {
        let day = studyDay ?? currentStudyDay
        var items = items(for: day)
        guard let index = items.firstIndex(where: { $0.id == id }) else { return }
        let wasCompleted = items[index].completed
        items[index].completed = completed
        replaceTasks(items, for: day)
        if completed && !wasCompleted {
            archive.completions.removeAll { $0.id == id }
            archive.completions.append(CompletionRecord(
                id: id,
                text: items[index].text,
                completedAt: Date(),
                dayKey: Self.dayKey()
            ))
        } else if !completed && wasCompleted {
            archive.completions.removeAll { $0.id == id }
        }
        save()
    }

    func update(id: UUID, rawText: String, studyDay: Int? = nil) {
        let text = rawText.trimmingCharacters(in: .whitespacesAndNewlines)
        let day = studyDay ?? currentStudyDay
        if text.isEmpty {
            remove(id: id, studyDay: day)
            return
        }
        var items = items(for: day)
        guard let index = items.firstIndex(where: { $0.id == id }) else { return }
        items[index].text = text
        items[index].categories = Self.categories(for: day, text: text)
        replaceTasks(items, for: day)
        if let recordIndex = archive.completions.firstIndex(where: { $0.id == id }) {
            archive.completions[recordIndex].text = text
        }
        save()
    }

    func remove(id: UUID, studyDay: Int? = nil) {
        let day = studyDay ?? currentStudyDay
        set(items(for: day).filter { $0.id != id }, for: day)
    }

    func advanceCurrentStudyDay() -> Bool {
        guard canAdvanceCurrentDay else { return false }
        archive.currentStudyDay += 1
        save()
        return true
    }

    func setCurrentStudyDay(_ day: Int) -> Bool {
        guard archive.planDays.contains(where: { $0.dayNumber == day }) else { return false }
        archive.currentStudyDay = day
        save()
        return true
    }

    func refreshAnkiProgress(force: Bool = false, completion: @escaping () -> Void) {
        if ankiRefreshInFlight { return }
        if !force, let last = ankiLastAttempt, Date().timeIntervalSince(last) < 30 { return }
        ankiRefreshInFlight = true
        ankiLastAttempt = Date()

        let actions = Self.ankiDecks.flatMap { deck -> [[String: Any]] in
            let quoted = "deck:\"\(deck)\""
            return [
                ["action": "findCards", "params": ["query": quoted]],
                ["action": "findCards", "params": ["query": quoted + " is:new"]]
            ]
        }
        let payload: [String: Any] = ["action": "multi", "version": 6, "params": ["actions": actions]]
        let endpointText = ProcessInfo.processInfo.environment["LULU_ANKI_URL"] ?? "http://127.0.0.1:8765"
        guard let body = try? JSONSerialization.data(withJSONObject: payload),
              let endpoint = URL(string: endpointText) else {
            ankiRefreshInFlight = false
            return
        }
        var request = URLRequest(url: endpoint, timeoutInterval: 2.5)
        request.httpMethod = "POST"
        request.setValue("application/json", forHTTPHeaderField: "Content-Type")
        request.httpBody = body

        URLSession.shared.dataTask(with: request) { [weak self] data, _, _ in
            guard let self else { return }
            var fresh: [String: AnkiDeckProgress] = [:]
            if let data,
               let json = try? JSONSerialization.jsonObject(with: data) as? [String: Any],
               json["error"] is NSNull,
               let results = json["result"] as? [[Any]],
               results.count == Self.ankiDecks.count * 2 {
                let now = Date()
                for (index, deck) in Self.ankiDecks.enumerated() {
                    let total = results[index * 2].count
                    let unseen = results[index * 2 + 1].count
                    fresh[deck] = AnkiDeckProgress(learned: max(0, total - unseen), total: total, updatedAt: now)
                }
            }
            DispatchQueue.main.async {
                self.ankiRefreshInFlight = false
                self.ankiConnected = !fresh.isEmpty
                if !fresh.isEmpty {
                    self.archive.ankiProgressCache.merge(fresh) { _, new in new }
                    self.save()
                }
                completion()
            }
        }.resume()
    }

    private func set(_ items: [TodoItem], for studyDay: Int) {
        replaceTasks(items, for: studyDay)
        save()
    }

    private func replaceTasks(_ items: [TodoItem], for studyDay: Int) {
        guard let index = archive.planDays.firstIndex(where: { $0.dayNumber == studyDay }) else { return }
        archive.planDays[index].tasks = items
    }

    private func load() {
        let decoder = JSONDecoder()
        decoder.dateDecodingStrategy = .iso8601
        guard let data = try? Data(contentsOf: url),
              let value = try? decoder.decode(TodoArchive.self, from: data) else { return }
        archive = value
        var migrated = archive.schemaVersion < 2
        archive.schemaVersion = 2
        archive.planDays.sort { $0.dayNumber < $1.dayNumber }
        archive.currentStudyDay = max(1, min(archive.currentStudyDay, archive.planDays.last?.dayNumber ?? 28))
        let recordedIDs = Set(archive.completions.map(\.id))
        for dayIndex in archive.planDays.indices {
            let day = archive.planDays[dayIndex].dayNumber
            for itemIndex in archive.planDays[dayIndex].tasks.indices {
                if archive.planDays[dayIndex].tasks[itemIndex].categories.isEmpty {
                    let text = archive.planDays[dayIndex].tasks[itemIndex].text
                    archive.planDays[dayIndex].tasks[itemIndex].categories = Self.categories(for: day, text: text)
                    migrated = true
                }
            }
            for item in archive.planDays[dayIndex].tasks where item.completed && !recordedIDs.contains(item.id) {
                archive.completions.append(CompletionRecord(
                    id: item.id,
                    text: item.text,
                    completedAt: item.createdAt,
                    dayKey: Self.dayKey(for: item.createdAt)
                ))
                migrated = true
            }
        }
        if migrated { save() }
    }

    private func save() {
        let encoder = JSONEncoder()
        encoder.outputFormatting = [.prettyPrinted, .sortedKeys]
        encoder.dateEncodingStrategy = .iso8601
        guard let data = try? encoder.encode(archive) else { return }
        try? data.write(to: url, options: .atomic)
    }

    static func theme(for day: Int) -> String {
        let themes = [
            "三个项目总结", "视觉项目地图与快速入门", "Qt入口与模块通信", "LIME与ADMM原理",
            "LIME性能优化", "LSTR与ONNX Runtime", "Unet、NCNN与Qt图像处理", "视觉项目面试内容",
            "RTOS高频题与入门", "RTOS架构与任务设计", "中断、定时任务与电机闭环", "传感器、交互与工作模式",
            "自动模式、IAP与调试", "任务监控与扩展内容", "RTOS查漏", "物理内存高频题与事实边界",
            "eBPF架构与伙伴系统", "探针、BPF map与指标采集", "用户态与全链路追踪", "物理内存深入复习",
            "Anki集中复习·视觉薄弱点", "Anki集中复习·RTOS任务与电机", "Anki集中复习·RTOS IAP与调试", "Anki集中复习·内存碎片",
            "视觉项目面试复习", "RTOS高频题复习", "Linux物理高频题复习", "收尾与补齐"
        ]
        return themes.indices.contains(day - 1) ? themes[day - 1] : "学习计划"
    }

    static func categories(for day: Int, text: String) -> [TaskCategory] {
        var categories: [TaskCategory] = []
        func add(_ category: TaskCategory) {
            if !categories.contains(category) { categories.append(category) }
        }
        if text.localizedCaseInsensitiveContains("Anki") { add(.anki) }
        if day == 1 && !text.localizedCaseInsensitiveContains("Anki") {
            add(.linuxVisual); add(.rtos); add(.linuxPhysical)
        } else if (2...8).contains(day) {
            add(.linuxVisual)
        } else if (9...15).contains(day) {
            add(.rtos)
        } else if (16...20).contains(day) {
            add(.linuxPhysical)
        } else {
            if text.contains("三个项目") {
                add(.linuxVisual); add(.rtos); add(.linuxPhysical)
            }
            if text.contains("视觉") { add(.linuxVisual) }
            if text.localizedCaseInsensitiveContains("RTOS") || text.contains("rtos项目") { add(.rtos) }
            if text.contains("Linux物理") || text.contains("伙伴系统") || text.contains("order") || text.contains("碎片") { add(.linuxPhysical) }
        }
        if categories.isEmpty { add(.general) }
        return categories
    }
}

private class FlippedView: NSView {
    override var isFlipped: Bool { true }
}

private func makeGlassContainer(for contentView: NSView, cornerRadius: CGFloat = 16) -> NSVisualEffectView {
    let glassView = NSVisualEffectView(frame: contentView.frame)
    glassView.material = .hudWindow
    glassView.blendingMode = .behindWindow
    glassView.state = .active
    glassView.wantsLayer = true
    glassView.layer?.cornerRadius = cornerRadius
    glassView.layer?.masksToBounds = true
    glassView.layer?.borderWidth = 1
    glassView.layer?.borderColor = NSColor.white.withAlphaComponent(0.16).cgColor
    contentView.frame = glassView.bounds
    contentView.autoresizingMask = [.width, .height]
    glassView.addSubview(contentView)
    return glassView
}

private final class BadgeView: NSView {
    private let quickTimerButton = NSButton(title: "▶ 正计时", target: nil, action: nil)
    private let closeButton = NSButton(title: "×", target: nil, action: nil)
    var usageTitle = "Codex · 读取中…" { didSet { needsDisplay = true } }
    var remaining: Int? { didSet { needsDisplay = true } }
    var completed = 0 { didSet { needsDisplay = true } }
    var total = 0 { didSet { needsDisplay = true } }
    var isTimerRunning = false { didSet { updateTimerButton() } }
    var onClick: (() -> Void)?
    var onQuickStartTimer: (() -> Void)?
    var onClose: (() -> Void)?

    override init(frame frameRect: NSRect) {
        super.init(frame: frameRect)
        quickTimerButton.target = self
        quickTimerButton.action = #selector(quickStartTimer)
        quickTimerButton.isBordered = false
        quickTimerButton.font = .systemFont(ofSize: 10.5, weight: .semibold)
        quickTimerButton.contentTintColor = .systemOrange
        quickTimerButton.toolTip = "直接开始番茄钟正计时"
        quickTimerButton.wantsLayer = true
        quickTimerButton.layer?.backgroundColor = NSColor.systemOrange.withAlphaComponent(0.16).cgColor
        quickTimerButton.layer?.cornerRadius = 8
        addSubview(quickTimerButton)

        closeButton.target = self
        closeButton.action = #selector(closeBadge)
        closeButton.isBordered = false
        closeButton.font = .systemFont(ofSize: 13, weight: .medium)
        closeButton.contentTintColor = NSColor.white.withAlphaComponent(0.58)
        closeButton.toolTip = "隐藏卡片（右击 Lulu 可重新打开）"
        addSubview(closeButton)
    }

    required init?(coder: NSCoder) { nil }

    override func layout() {
        super.layout()
        quickTimerButton.frame = NSRect(x: bounds.width - 72, y: 4, width: 62, height: 22)
        closeButton.frame = NSRect(x: bounds.width - 23, y: 35, width: 16, height: 17)
    }

    override func draw(_ dirtyRect: NSRect) {
        super.draw(dirtyRect)
        let card = NSBezierPath(
            roundedRect: bounds.insetBy(dx: 0.5, dy: 0.5),
            xRadius: 13,
            yRadius: 13
        )
        NSColor(calibratedWhite: 0.08, alpha: 0.26).setFill()
        card.fill()
        NSColor.white.withAlphaComponent(0.24).setStroke()
        card.lineWidth = 1
        card.stroke()

        let usageColor: NSColor
        if let remaining {
            usageColor = remaining <= 20 ? .systemRed : remaining <= 50 ? .systemYellow : .systemGreen
        } else {
            usageColor = .secondaryLabelColor
        }

        usageColor.setFill()
        NSBezierPath(ovalIn: NSRect(x: 11, y: 42, width: 6, height: 6)).fill()

        let rawUsage = usageTitle.replacingOccurrences(of: "Codex · ", with: "")
        let focusedUsage = rawUsage.components(separatedBy: "  ").last ?? rawUsage
        let usageValue = NSAttributedString(string: focusedUsage, attributes: [
            .font: NSFont.systemFont(ofSize: 10.8, weight: .semibold),
            .foregroundColor: usageColor
        ])
        usageValue.draw(
            with: NSRect(x: 22, y: 35, width: bounds.width - 50, height: 17),
            options: [.usesLineFragmentOrigin, .truncatesLastVisibleLine]
        )

        NSColor.white.withAlphaComponent(0.10).setStroke()
        let divider = NSBezierPath()
        divider.move(to: NSPoint(x: 11, y: 29))
        divider.line(to: NSPoint(x: bounds.width - 11, y: 29))
        divider.lineWidth = 1
        divider.stroke()

        NSAttributedString(string: "☑︎  今日任务", attributes: [
            .font: NSFont.systemFont(ofSize: 11.5, weight: .medium),
            .foregroundColor: NSColor.white.withAlphaComponent(0.9)
        ]).draw(at: NSPoint(x: 11, y: 8))

        let progress = NSAttributedString(string: "\(completed)/\(total)", attributes: [
            .font: NSFont.monospacedDigitSystemFont(ofSize: 10.5, weight: .semibold),
            .foregroundColor: total > 0 && completed == total
                ? NSColor.systemGreen
                : NSColor.white.withAlphaComponent(0.8)
        ])
        progress.draw(at: NSPoint(x: bounds.width - 79 - progress.size().width, y: 9))
    }

    @objc private func quickStartTimer() {
        onQuickStartTimer?()
    }

    @objc private func closeBadge() {
        onClose?()
    }

    private func updateTimerButton() {
        quickTimerButton.title = isTimerRunning ? "● 计时中" : "▶ 正计时"
        let color: NSColor = isTimerRunning ? .systemGreen : .systemOrange
        quickTimerButton.contentTintColor = color
        quickTimerButton.layer?.backgroundColor = color.withAlphaComponent(isTimerRunning ? 0.22 : 0.16).cgColor
        quickTimerButton.toolTip = isTimerRunning ? "正在计时，点击打开番茄钟" : "直接开始番茄钟正计时"
    }

    override func mouseDown(with event: NSEvent) {
        onClick?()
    }

    override func resetCursorRects() {
        addCursorRect(bounds, cursor: .pointingHand)
    }
}

