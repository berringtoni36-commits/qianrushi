    private let modeControl = NSSegmentedControl(labels: ["今日任务", "28天计划", "学习记录", "番茄钟"], trackingMode: .selectOne, target: nil, action: nil)
    private let dateLabel = NSTextField(wrappingLabelWithString: "")
    private let previousDayButton = NSButton(title: "‹", target: nil, action: nil)
    private let nextDayButton = NSButton(title: "›", target: nil, action: nil)
    private let inputField = NSTextField(string: "")
    private let addButton = NSButton(title: "添加", target: nil, action: nil)
    private let advanceButton = NSButton(title: "进入下一学习日", target: nil, action: nil)
    private let setCurrentButton = NSButton(title: "设为当前学习日", target: nil, action: nil)
    private let scrollView = NSScrollView()
    private let documentView = FlippedView()
    private let footerLabel = NSTextField(labelWithString: "")
    private let focusView: FocusTimerView
    private var loadedCalendarDay = ""
    private var selectedPlanDay = 0
    private var isPlanMode: Bool { modeControl.selectedSegment == 1 }
    private var isHistoryMode: Bool { modeControl.selectedSegment == 2 }
    private var isFocusMode: Bool { modeControl.selectedSegment == 3 }
    var onProgressChanged: ((Int, Int) -> Void)?
    var onFocusRunningChanged: ((Bool) -> Void)? {
        didSet { focusView.onRunningChanged = onFocusRunningChanged }
    }

    private static let historyDateFormatter: DateFormatter = {
        let formatter = DateFormatter()
        formatter.locale = Locale(identifier: "zh_CN")
        formatter.timeZone = .current
        formatter.dateFormat = "M月d日 EEEE"
        return formatter
    }()

    init(store: TodoStore) {
        self.store = store
        focusView = FocusTimerView(store: store)
        super.init(frame: .zero)

        titleLabel.font = .systemFont(ofSize: 18, weight: .bold)
        modeControl.selectedSegment = 0
        modeControl.target = self
        modeControl.action = #selector(switchPanelMode)
        dateLabel.font = .systemFont(ofSize: 11)
        dateLabel.textColor = .secondaryLabelColor
        dateLabel.maximumNumberOfLines = 2
        inputField.delegate = self

        previousDayButton.target = self
        previousDayButton.action = #selector(showPreviousPlanDay)
        previousDayButton.bezelStyle = .rounded
        previousDayButton.font = .systemFont(ofSize: 18, weight: .semibold)
        nextDayButton.target = self
        nextDayButton.action = #selector(showNextPlanDay)
        nextDayButton.bezelStyle = .rounded
        nextDayButton.font = .systemFont(ofSize: 18, weight: .semibold)
        addButton.target = self
        addButton.action = #selector(addTask)
        addButton.bezelStyle = .rounded
        advanceButton.target = self
        advanceButton.action = #selector(advanceStudyDay)
        advanceButton.bezelStyle = .rounded
        advanceButton.contentTintColor = .systemBlue
        setCurrentButton.target = self
        setCurrentButton.action = #selector(setSelectedAsCurrent)
        setCurrentButton.bezelStyle = .rounded

        scrollView.hasVerticalScroller = true
        scrollView.hasHorizontalScroller = false
        scrollView.autohidesScrollers = true
        scrollView.drawsBackground = false
        scrollView.documentView = documentView
        footerLabel.font = .systemFont(ofSize: 11)
        footerLabel.textColor = .secondaryLabelColor
        footerLabel.alignment = .center

        [titleLabel, modeControl, dateLabel, previousDayButton, nextDayButton, inputField, addButton,
         advanceButton, setCurrentButton, scrollView, footerLabel, focusView].forEach(addSubview)
        reload()
    }

    required init?(coder: NSCoder) { nil }

    override func layout() {
        super.layout()
        let width = bounds.width
        titleLabel.frame = NSRect(x: 16, y: 14, width: 92, height: 24)
        modeControl.frame = NSRect(x: width - 338, y: 13, width: 322, height: 26)
        previousDayButton.frame = NSRect(x: 16, y: 46, width: 30, height: 25)
        nextDayButton.frame = NSRect(x: width - 46, y: 46, width: 30, height: 25)
        dateLabel.frame = NSRect(x: isPlanMode ? 52 : 16, y: 46, width: isPlanMode ? width - 104 : width - 32, height: isPlanMode || isHistoryMode ? 22 : 36)
        dateLabel.alignment = isPlanMode ? .center : .left
        addButton.frame = NSRect(x: width - 72, y: 88, width: 56, height: 30)
        inputField.frame = NSRect(x: 16, y: 88, width: width - 96, height: 30)

        let top: CGFloat = isHistoryMode ? 76 : 128
        let bottom: CGFloat = (isHistoryMode || isFocusMode) ? 42 : 82
        scrollView.frame = NSRect(x: 12, y: top, width: width - 24, height: max(80, bounds.height - top - bottom))
        focusView.frame = NSRect(x: 16, y: 73, width: width - 32, height: bounds.height - 113)
        advanceButton.frame = NSRect(x: (width - 190) / 2, y: bounds.height - 72, width: 190, height: 30)
        setCurrentButton.frame = NSRect(x: (width - 180) / 2, y: bounds.height - 72, width: 180, height: 30)
        footerLabel.frame = NSRect(x: 16, y: bounds.height - 32, width: width - 32, height: 18)
        layoutRows()
    }

    func refreshForNewDay() {
        let day = TodoStore.dayKey()
        if day != loadedCalendarDay { reload() }
    }

    func toggleCountUpFromBadge() { focusView.toggleCountUpFromBadge() }

    private func reload() {
        loadedCalendarDay = TodoStore.dayKey()
        documentView.subviews.forEach { $0.removeFromSuperview() }
        inputField.isHidden = isHistoryMode || isFocusMode
        addButton.isHidden = isHistoryMode || isFocusMode
        previousDayButton.isHidden = !isPlanMode
        nextDayButton.isHidden = !isPlanMode
        advanceButton.isHidden = true
        setCurrentButton.isHidden = true
        scrollView.isHidden = isFocusMode
        footerLabel.isHidden = isFocusMode
        focusView.isHidden = !isFocusMode

        if isFocusMode {
            dateLabel.stringValue = "自定义专注时间，完成后自动记入学习记录"
            focusView.refreshStats()
        } else if isHistoryMode {
            reloadHistory()
        } else if isPlanMode {
            reloadPlan()
        } else {
            reloadToday()
        }
        needsLayout = true
        layoutSubtreeIfNeeded()
    }

    private func reloadToday() {
        let day = store.currentStudyDay
        let status = store.deadlineStatus
        dateLabel.stringValue = "第\(day)学习日 / 28 · \(store.title(for: day))\n截止 \(status.targetDateText) · 剩余\(status.remainingStudyDays)学习日/\(status.remainingCalendarDays)自然日 · 建议每周\(String(format: "%.1f", status.weeklyPace))天"
        inputField.placeholderString = "添加到第\(day)学习日…"
        for item in store.today where !item.completed {
            let row = makeTodoRow(item: item, studyDay: day)
            documentView.addSubview(row)
        }
        updateProgress()
        advanceButton.title = "进入第\(day + 1)学习日"
        advanceButton.isHidden = !store.canAdvanceCurrentDay
    }

    private func reloadPlan() {
        let days = store.planDays
        if selectedPlanDay == 0 || !days.contains(where: { $0.dayNumber == selectedPlanDay }) {
            selectedPlanDay = store.currentStudyDay
        }
        let index = days.firstIndex(where: { $0.dayNumber == selectedPlanDay }) ?? 0
        let day = days.indices.contains(index) ? days[index] : PlanDay(dayNumber: 1, title: "", tasks: [])
        let currentMark = day.dayNumber == store.currentStudyDay ? " · 当前学习日" : ""
        dateLabel.stringValue = "第\(day.dayNumber)学习日 / \(max(1, days.count)) · \(day.title)\(currentMark)"
        inputField.placeholderString = "添加到第\(day.dayNumber)学习日…"
        previousDayButton.isEnabled = index > 0
        nextDayButton.isEnabled = !days.isEmpty && index < days.count - 1
        for item in day.tasks { documentView.addSubview(makeTodoRow(item: item, studyDay: day.dayNumber)) }
        let completed = day.tasks.filter(\.completed).count
        footerLabel.stringValue = "已完成 \(completed) / \(day.tasks.count) · 任务可换行编辑、增删和勾选"
        setCurrentButton.isHidden = day.dayNumber == store.currentStudyDay
    }

    private func makeTodoRow(item: TodoItem, studyDay: Int) -> TodoRowView {
        TodoRowView(
            item: item,
            onToggle: { [weak self] id, completed in
                self?.store.setCompleted(id: id, completed: completed, studyDay: studyDay)
                self?.reload()
            },
            onEdit: { [weak self] id, text in
                self?.store.update(id: id, rawText: text, studyDay: studyDay)
                DispatchQueue.main.async { [weak self] in self?.reload() }
            },
            onDelete: { [weak self] id in
                self?.store.remove(id: id, studyDay: studyDay)
                self?.reload()
            }
        )
    }

    private func reloadHistory() {
        let stats = store.learningStats
        dateLabel.stringValue = "近7天完成 \(stats.recentCompleted) 项 · 累计学习 \(stats.activeDays) 天 · 连续 \(stats.streak) 天"
        let dashboard = LearningDashboardView(projects: store.projectProgress, anki: store.ankiProgress, connected: store.ankiConnected)
        dashboard.onRefresh = { [weak self] in
            self?.store.refreshAnkiProgress(force: true) { [weak self] in self?.reload() }
        }
        documentView.addSubview(dashboard)

        for day in store.history {
            let title: String
            if day.dayKey == TodoStore.dayKey() {
                title = "今天"
            } else if let date = TodoStore.date(for: day.dayKey) {
                title = Self.historyDateFormatter.string(from: date)
            } else {
                title = day.dayKey
            }
            documentView.addSubview(HistoryDayView(title: title, records: day.records, focusSeconds: day.focusSeconds, focusCount: day.focusCount))
        }
        footerLabel.stringValue = "任务与专注记录按实际完成日期保存"
        store.refreshAnkiProgress { [weak self] in
            guard self?.isHistoryMode == true else { return }
            self?.reload()
        }
    }

    private func layoutRows() {
        let rowWidth = scrollView.contentSize.width
        var y: CGFloat = 0
        if isHistoryMode {
            for subview in documentView.subviews {
                if let dashboard = subview as? LearningDashboardView {
                    dashboard.frame = NSRect(x: 0, y: y, width: rowWidth, height: dashboard.preferredHeight)
                    y += dashboard.preferredHeight + 14
                } else if let section = subview as? HistoryDayView {
                    section.frame = NSRect(x: 0, y: y, width: rowWidth, height: section.preferredHeight)
                    y += section.preferredHeight + 10
                }
            }
        } else {
            for case let row as TodoRowView in documentView.subviews {
                let rowHeight = row.preferredHeight(for: rowWidth)
                row.frame = NSRect(x: 0, y: y, width: rowWidth, height: rowHeight)
                y += rowHeight + 6
            }
        }
        documentView.frame = NSRect(x: 0, y: 0, width: rowWidth, height: max(scrollView.contentSize.height, max(0, y - 6)))
    }

    @objc private func switchPanelMode() {
        if isPlanMode { selectedPlanDay = store.currentStudyDay }
        reload()
    }

    @objc private func showPreviousPlanDay() { movePlanDay(by: -1) }
    @objc private func showNextPlanDay() { movePlanDay(by: 1) }

    private func movePlanDay(by offset: Int) {
        let days = store.planDays
        guard let index = days.firstIndex(where: { $0.dayNumber == selectedPlanDay }) else { return }
        let nextIndex = index + offset
        guard days.indices.contains(nextIndex) else { return }
        selectedPlanDay = days[nextIndex].dayNumber
        reload()
    }

    private func updateProgress() {
        let progress = store.progress
        if progress.total == 0 {
            footerLabel.stringValue = "当前学习日没有任务，可添加任务或直接进入下一日"
        } else if progress.completed == progress.total {
            footerLabel.stringValue = store.currentStudyDay == 28 ? "28天计划已全部完成 ✓" : "本学习日已全部完成，确认后再进入下一日"
        } else {
            footerLabel.stringValue = "待完成 \(progress.total - progress.completed) 项 · 已完成 \(progress.completed) / \(progress.total)"
        }
        onProgressChanged?(progress.completed, progress.total)
    }

    @objc private func addTask() {
        store.add(inputField.stringValue, to: isPlanMode ? selectedPlanDay : nil)
        inputField.stringValue = ""
        reload()
        window?.makeFirstResponder(inputField)
    }

    @objc private func advanceStudyDay() {
        let next = store.currentStudyDay + 1
        let alert = NSAlert()
        alert.messageText = "进入第\(next)学习日？"
        alert.informativeText = "只会推进当前学习日，不会改变任务的完成记录。"
        alert.addButton(withTitle: "进入下一日")
        alert.addButton(withTitle: "取消")
        guard alert.runModal() == .alertFirstButtonReturn else { return }
        if store.advanceCurrentStudyDay() { reload() }
    }

    @objc private func setSelectedAsCurrent() {
        let alert = NSAlert()
        alert.messageText = "将第\(selectedPlanDay)天设为当前学习日？"
        alert.informativeText = "这个操作用于误操作恢复或主动回退，不会删除已有记录。"
        alert.addButton(withTitle: "确认设置")
        alert.addButton(withTitle: "取消")
        guard alert.runModal() == .alertFirstButtonReturn else { return }
        if store.setCurrentStudyDay(selectedPlanDay) { reload() }
    }

    func control(_ control: NSControl, textView: NSTextView, doCommandBy commandSelector: Selector) -> Bool {
        if control === inputField && commandSelector == #selector(NSResponder.insertNewline(_:)) {
            addTask()
            return true
        }
        return false
    }
}

private final class LuluOverlay: NSObject, NSWindowDelegate {
    private let badgeWindow: NSWindow
    private let badgeGlassView: NSVisualEffectView
    private let badgeView: BadgeView
    private let panelWindow: NSPanel
    private let panelView: TodoPanelView
    private var panelOpen = false
    private var panelFollowOffset: NSPoint?
    private var targetBadgeOrigin = NSPoint.zero
    private var displayedBadgeOrigin = NSPoint.zero
    private var hasBadgeOrigin = false
    private var lastAnimationTime = ProcessInfo.processInfo.systemUptime
    private var petFrame = NSRect.zero
    private var petIsVisible = false
    private var badgeManuallyHidden = !settingsStore.value.badgeVisible
    private var globalRightClickMonitor: Any?

    override init() {
        let store = TodoStore()
        badgeView = BadgeView(frame: NSRect(
            x: 0,
            y: 0,
            width: settingsStore.value.badgeWidth,
            height: settingsStore.value.badgeHeight
        ))
        badgeGlassView = NSVisualEffectView(frame: badgeView.bounds)
        badgeWindow = NSWindow(
            contentRect: badgeView.bounds,
            styleMask: .borderless,
            backing: .buffered,
            defer: false
        )
        panelView = TodoPanelView(store: store)
        panelWindow = NSPanel(
            contentRect: NSRect(x: 0, y: 0, width: 460, height: 540),
            styleMask: [.titled, .closable, .utilityWindow],
            backing: .buffered,
            defer: false
        )
        super.init()

        badgeWindow.isOpaque = false
        badgeWindow.backgroundColor = .clear
        badgeWindow.hasShadow = true
        badgeWindow.level = .floating
        badgeWindow.collectionBehavior = [.canJoinAllSpaces, .fullScreenAuxiliary]
        badgeGlassView.material = .hudWindow
        badgeGlassView.blendingMode = .behindWindow
        badgeGlassView.state = .active
        badgeGlassView.wantsLayer = true
        badgeGlassView.layer?.cornerRadius = 13
        badgeGlassView.layer?.masksToBounds = true
        badgeView.autoresizingMask = [.width, .height]
        badgeGlassView.addSubview(badgeView)
        badgeWindow.contentView = badgeGlassView
        badgeWindow.acceptsMouseMovedEvents = true

        panelWindow.title = "Lulu · 学习计划与记录"
        panelWindow.isReleasedWhenClosed = false
        panelWindow.isOpaque = false
        panelWindow.backgroundColor = .clear
        panelWindow.hasShadow = true
        panelWindow.titlebarAppearsTransparent = true
        panelWindow.level = .floating
        panelWindow.hidesOnDeactivate = false
        panelWindow.collectionBehavior = [.canJoinAllSpaces, .fullScreenAuxiliary]
        panelWindow.contentView = makeGlassContainer(for: panelView)
        panelWindow.delegate = self
        if let closeButton = panelWindow.standardWindowButton(.closeButton) {
            closeButton.target = self
            closeButton.action = #selector(hideTaskPanel)
            closeButton.toolTip = "隐藏学习面板（Lulu 继续运行）"
        }

        badgeView.onClick = { [weak self] in self?.togglePanel() }
        badgeView.onQuickStartTimer = { [weak self] in self?.toggleCountUpFromBadge() }
        badgeView.onClose = { [weak self] in self?.hideBadge() }
        panelView.onProgressChanged = { [weak self] completed, total in
            self?.badgeView.completed = completed
            self?.badgeView.total = total
        }
        panelView.onFocusRunningChanged = { [weak self] isRunning in
            self?.badgeView.isTimerRunning = isRunning
        }
        let progress = store.progress
        badgeView.completed = progress.completed
        badgeView.total = progress.total

        globalRightClickMonitor = NSEvent.addGlobalMonitorForEvents(matching: .rightMouseDown) { [weak self] _ in
            guard let self, self.petIsVisible, self.petFrame.contains(NSEvent.mouseLocation) else { return }
            DispatchQueue.main.async { self.toggleBadgeFromPet() }
        }
    }

    deinit {
        if let globalRightClickMonitor { NSEvent.removeMonitor(globalRightClickMonitor) }
    }

    func setVisible(_ visible: Bool) {
        let becameVisible = visible && !petIsVisible
        petIsVisible = visible
        if visible && !badgeManuallyHidden {
            if becameVisible { snapToTargetOrigin() }
            badgeWindow.orderFrontRegardless()
            if panelOpen { panelWindow.orderFrontRegardless() }
        } else {
            badgeWindow.orderOut(nil)
            panelWindow.orderOut(nil)
        }
    }

    func setPetFrame(_ frame: NSRect) {
        petFrame = frame
    }

    func setUsageTitle(_ title: String, remaining: Int?, deadlineTooltip: String?) {
        badgeView.usageTitle = title
        badgeView.remaining = remaining
        badgeView.toolTip = deadlineTooltip
    }

    func setOrigin(_ origin: NSPoint) {
        if hasBadgeOrigin,
           abs(origin.x - targetBadgeOrigin.x) < 0.05,
           abs(origin.y - targetBadgeOrigin.y) < 0.05 { return }
        targetBadgeOrigin = origin
        if !hasBadgeOrigin {
            displayedBadgeOrigin = origin
            hasBadgeOrigin = true
            lastAnimationTime = ProcessInfo.processInfo.systemUptime
            positionWindows(at: origin)
        }
    }

    func advancePosition() {
        guard hasBadgeOrigin, petIsVisible, !badgeManuallyHidden else { return }

        let now = ProcessInfo.processInfo.systemUptime
        let deltaTime = min(max(now - lastAnimationTime, 1.0 / 240.0), 1.0 / 20.0)
        lastAnimationTime = now

        let dx = targetBadgeOrigin.x - displayedBadgeOrigin.x
        let dy = targetBadgeOrigin.y - displayedBadgeOrigin.y
        if abs(dx) < 0.15, abs(dy) < 0.15 {
            guard displayedBadgeOrigin != targetBadgeOrigin else { return }
            displayedBadgeOrigin = targetBadgeOrigin
        } else {
            // State-file updates arrive in small, uneven jumps while Lulu is dragged.
            // A time-based response keeps window motion fluid on both 60 Hz and 120 Hz displays.
            let blend = CGFloat(1.0 - exp(-50.0 * deltaTime))
            displayedBadgeOrigin.x += dx * blend
            displayedBadgeOrigin.y += dy * blend
        }
        positionWindows(at: displayedBadgeOrigin)
    }

    func refreshForNewDay() {
        panelView.refreshForNewDay()
    }

    private func togglePanel() {
        panelOpen.toggle()
        if panelOpen {
            panelFollowOffset = nil
            positionWindows(at: displayedBadgeOrigin)
            NSApp.activate(ignoringOtherApps: true)
            panelWindow.makeKeyAndOrderFront(nil)
        } else {
            panelFollowOffset = nil
            panelWindow.orderOut(nil)
        }
    }

    private func toggleCountUpFromBadge() {
        panelView.toggleCountUpFromBadge()
    }

    private func hideBadge() {
        badgeManuallyHidden = true
        settingsStore.update { $0.badgeVisible = false }
        panelOpen = false
        panelFollowOffset = nil
        badgeWindow.orderOut(nil)
        panelWindow.orderOut(nil)
    }

    private func toggleBadgeFromPet() {
        badgeManuallyHidden.toggle()
        settingsStore.update { $0.badgeVisible = !badgeManuallyHidden }
        if badgeManuallyHidden {
            panelOpen = false
            panelFollowOffset = nil
            badgeWindow.orderOut(nil)
            panelWindow.orderOut(nil)
        } else if petIsVisible {
            snapToTargetOrigin()
            badgeWindow.orderFrontRegardless()
        }
    }

    private func snapToTargetOrigin() {
        guard hasBadgeOrigin else { return }
        displayedBadgeOrigin = targetBadgeOrigin
        lastAnimationTime = ProcessInfo.processInfo.systemUptime
        positionWindows(at: displayedBadgeOrigin)
    }

    private func positionWindows(at origin: NSPoint) {
        let badgeSize = badgeWindow.frame.size
        let screenFrame = NSScreen.screens.first(where: { $0.visibleFrame.contains(origin) })?.visibleFrame
            ?? NSScreen.main?.visibleFrame
            ?? NSRect(x: 0, y: 0, width: 1440, height: 900)

        let badgeX = min(max(origin.x, screenFrame.minX + 8), screenFrame.maxX - badgeSize.width - 8)
        let badgeY = min(max(origin.y, screenFrame.minY + 8), screenFrame.maxY - badgeSize.height - 8)
        badgeWindow.setFrameOrigin(NSPoint(x: badgeX, y: badgeY))

        let panelSize = panelWindow.frame.size
        if panelOpen, let offset = panelFollowOffset {
            panelWindow.setFrameOrigin(NSPoint(x: badgeX + offset.x, y: badgeY + offset.y))
            return
        }

        var panelX = badgeX
        var panelY = badgeY - panelSize.height - 8
        if panelY < screenFrame.minY + 8 { panelY = badgeY + badgeSize.height + 8 }
        panelX = min(max(panelX, screenFrame.minX + 8), screenFrame.maxX - panelSize.width - 8)
        panelY = min(max(panelY, screenFrame.minY + 8), screenFrame.maxY - panelSize.height - 8)
        panelWindow.setFrameOrigin(NSPoint(x: panelX, y: panelY))
        if panelOpen {
            panelFollowOffset = NSPoint(x: panelX - badgeX, y: panelY - badgeY)
        }
    }

    func windowShouldClose(_ sender: NSWindow) -> Bool {
        hideTaskPanel()
        return false
    }

    @objc private func hideTaskPanel() {
        panelOpen = false
        panelFollowOffset = nil
        panelWindow.orderOut(nil)
    }
}

private final class RateLimitClient: NSObject {
    private let process = Process()
    private let input = Pipe()
    private let output = Pipe()
    private var buffer = ""
    private var initialized = false
    private var requestID = 2
    private let onUpdate: (String, Int?, String?) -> Void

    init(onUpdate: @escaping (String, Int?, String?) -> Void) {
        self.onUpdate = onUpdate
        super.init()
        start()
    }

    private func start() {
        process.executableURL = URL(fileURLWithPath: codexPath)
        process.arguments = ["app-server", "--listen", "stdio://"]
        process.standardInput = input
        process.standardOutput = output
        process.standardError = FileHandle.nullDevice
        var environment = ProcessInfo.processInfo.environment
        environment["CODEX_HOME"] = codexHome
        environment["PATH"] = "\(userHome)/.local/bin:\(userHome)/.local/share/pnpm/bin:\(userHome)/.local/node-v22.16.0-darwin-arm64/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin"
        process.environment = environment

        output.fileHandleForReading.readabilityHandler = { [weak self] handle in
            guard let self else { return }
            let data = handle.availableData
            if !data.isEmpty { receive(data) }
        }

        do {
            try process.run()
            send([
                "id": 1,
                "method": "initialize",
                "params": [
                    "clientInfo": ["name": "lulu-study-overlay", "title": "Lulu Study", "version": "2.0"],
                    "capabilities": [:]
                ]
            ])
        } catch {
            DispatchQueue.main.async { [onUpdate] in onUpdate("Codex · 不可用", nil, nil) }
        }
    }

    func refresh() {
        guard initialized else { return }
        send(["id": requestID, "method": "account/rateLimits/read", "params": [:]])
        requestID += 1
    }

    private func send(_ object: Any) {
        guard let line = jsonLine(object), let data = line.data(using: .utf8) else { return }
        input.fileHandleForWriting.write(data)
    }

    private func receive(_ data: Data) {
        guard let chunk = String(data: data, encoding: .utf8) else { return }
        buffer += chunk
        while let newline = buffer.firstIndex(of: "\n") {
            let line = String(buffer[..<newline])
            buffer = String(buffer[buffer.index(after: newline)...])
            handle(line)
        }
    }

    private func handle(_ line: String) {
        guard let data = line.data(using: .utf8),
              let message = try? JSONSerialization.jsonObject(with: data) as? [String: Any] else { return }

        if !initialized, let id = message["id"] as? NSNumber, id.intValue == 1 {
            initialized = true
            send(["method": "initialized", "params": [:]])
            refresh()
            return
        }

        guard let result = message["result"] as? [String: Any],
              let limits = result["rateLimits"] as? [String: Any],
              let primary = limits["primary"] as? [String: Any] else { return }

        let windows = [primary, limits["secondary"] as? [String: Any]].compactMap { $0 }
        let deadlineFormatter = DateFormatter()
        deadlineFormatter.locale = Locale(identifier: "zh_CN")
        deadlineFormatter.timeZone = TimeZone(identifier: "Asia/Shanghai")
        deadlineFormatter.dateFormat = "yyyy年M月d日 HH:mm"

        let parts = windows.compactMap { window -> (String, Int, String?)? in
            guard let used = number(window["usedPercent"]) else { return nil }
            let remaining = max(0, min(100, Int((100 - used).rounded())))
            let minutes = Int(number(window["windowDurationMins"]) ?? 0)
            let periodFallback: String
            if minutes <= 360 { periodFallback = "5h" }
            else if minutes >= 10080 { periodFallback = "7d" }
            else if minutes >= 1440 { periodFallback = "\(minutes / 1440)d" }
            else { periodFallback = "\(minutes / 60)h" }

            let remainingTime: String
            let tooltip: String?
            if let resetTimestamp = number(window["resetsAt"]) {
                let resetDate = Date(timeIntervalSince1970: resetTimestamp)
                let secondsUntilReset = max(0, Int(resetDate.timeIntervalSinceNow))
                let days = secondsUntilReset / 86_400
                let hours = (secondsUntilReset % 86_400) / 3_600
                let mins = max(1, (secondsUntilReset % 3_600) / 60)
                if days > 0 {
                    remainingTime = hours > 0 ? "\(days)d \(hours)h" : "\(days)d"
                } else if hours > 0 {
                    remainingTime = "\(hours)h"
                } else {
                    remainingTime = "\(mins)m"
                }
                tooltip = "Deadline: \(deadlineFormatter.string(from: resetDate)) (Beijing time)"
            } else {
                remainingTime = periodFallback
                tooltip = nil
            }
            return ("\(remainingTime) · \(remaining)%", remaining, tooltip)
        }

        guard !parts.isEmpty else {
            DispatchQueue.main.async { [onUpdate] in onUpdate("Codex · 暂无用量", nil, nil) }
            return
        }
        var labels = parts.map(\.0)
        let resetCredits = result["rateLimitResetCredits"] as? [String: Any]
        let resetCount = Int(number(resetCredits?["availableCount"]) ?? 0)
        labels[labels.count - 1] += " · Reset \(resetCount)"
        let title = "Codex · " + labels.joined(separator: "  ")
        let minimum = parts.map(\.1).min()
        let deadline = parts.compactMap { $0.2 }.last
        let tooltip = [deadline, "Reset cards available: \(resetCount)"].compactMap { $0 }.joined(separator: "\n")
        DispatchQueue.main.async { [onUpdate] in onUpdate(title, minimum, tooltip) }
    }
}

private final class AppController: NSObject {
    private struct PetLayout {
        let displayY: CGFloat
        let displayHeight: CGFloat
        let mascotLeft: CGFloat
        let mascotTop: CGFloat
        let mascotWidth: CGFloat
        let mascotHeight: CGFloat
        let overlayWidth: CGFloat
        let overlayHeight: CGFloat
    }

    private let overlay = LuluOverlay()
    private var stateTimer: Timer?
    private var refreshTimer: Timer?
    private var dayTimer: Timer?
    private var stateWatchSource: DispatchSourceFileSystemObject?
    private var stateDirectoryFD: Int32 = -1
    private var pendingStateFrames = 1
    private var livePollFrame = 0
    private var petLayout: PetLayout?
    private var avatarWindowID: CGWindowID?
    private var client: RateLimitClient!

    func start() {
        client = RateLimitClient { [weak self] title, remaining, deadlineTooltip in
            self?.overlay.setUsageTitle(title, remaining: remaining, deadlineTooltip: deadlineTooltip)
        }
        startStateWatcher()
        let displayTimer = Timer(timeInterval: 1.0 / 120.0, repeats: true) { [weak self] _ in
            guard let self else { return }
            if self.pendingStateFrames > 0 {
                self.pendingStateFrames -= 1
                self.syncPetState()
            }
            self.livePollFrame &+= 1
            if NSEvent.pressedMouseButtons & 1 != 0 || self.livePollFrame % 8 == 0 {
                self.syncLivePetPosition()
            }
            self.overlay.advancePosition()
        }
        displayTimer.tolerance = 1.0 / 1_000.0
        RunLoop.main.add(displayTimer, forMode: .common)
        stateTimer = displayTimer
        refreshTimer = Timer.scheduledTimer(withTimeInterval: settingsStore.value.usageRefreshSeconds, repeats: true) { [weak self] _ in
            self?.client.refresh()
        }
        dayTimer = Timer.scheduledTimer(withTimeInterval: 60, repeats: true) { [weak self] _ in
            self?.overlay.refreshForNewDay()
        }
        syncPetState()
    }

    deinit {
        stateTimer?.invalidate()
        refreshTimer?.invalidate()
        dayTimer?.invalidate()
        stateWatchSource?.cancel()
    }

    private func startStateWatcher() {
        let descriptor = open(codexHome, O_EVTONLY)
        guard descriptor >= 0 else {
            let fallback = Timer(timeInterval: 1.0 / 30.0, repeats: true) { [weak self] _ in
                self?.pendingStateFrames = 1
            }
            RunLoop.main.add(fallback, forMode: .common)
            return
        }
        stateDirectoryFD = descriptor
        let source = DispatchSource.makeFileSystemObjectSource(
            fileDescriptor: descriptor,
            eventMask: [.write, .rename, .delete],
            queue: DispatchQueue.global(qos: .userInteractive)
        )
        source.setEventHandler { [weak self] in
            DispatchQueue.main.async { self?.pendingStateFrames = 1 }
        }
        source.setCancelHandler { close(descriptor) }
        stateWatchSource = source
        source.resume()
    }

    private func syncPetState() {
        guard let data = try? Data(contentsOf: URL(fileURLWithPath: statePath)),
              let root = try? JSONSerialization.jsonObject(with: data) as? [String: Any] else {
            pendingStateFrames = max(pendingStateFrames, 2)
            return
        }
        guard let open = root["electron-avatar-overlay-open"] as? Bool,
              let bounds = root["electron-avatar-overlay-bounds"] as? [String: Any],
              let mascot = bounds["mascot"] as? [String: Any],
              let display = bounds["displayBounds"] as? [String: Any],
              open,
              let overlayX = point(bounds, "x"),
              let overlayY = point(bounds, "y"),
              let mascotLeft = point(mascot, "left"),
              let mascotTop = point(mascot, "top"),
              let mascotWidth = point(mascot, "width"),
              let mascotHeight = point(mascot, "height"),
              let displayX = point(display, "x"),
              let displayY = point(display, "y"),
              let overlayWidth = point(bounds, "width"),
              let overlayHeight = point(bounds, "height"),
              let displayHeight = point(display, "height"),
              open else {
            petLayout = nil
            avatarWindowID = nil
            overlay.setVisible(false)
            return
        }

        let layout = PetLayout(
            displayY: displayY,
            displayHeight: displayHeight,
            mascotLeft: mascotLeft,
            mascotTop: mascotTop,
            mascotWidth: mascotWidth,
            mascotHeight: mascotHeight,
            overlayWidth: overlayWidth,
            overlayHeight: overlayHeight
        )
        petLayout = layout
        let windowX = displayX + overlayX
        let windowY = displayY + overlayY
        if avatarWindowID == nil {
            avatarWindowID = findAvatarWindow(
                expectedX: windowX,
                expectedY: windowY,
                layout: layout
            )
        }
        applyPetPosition(windowX: windowX, windowY: windowY, layout: layout)
    }

    private func syncLivePetPosition() {
        guard let layout = petLayout else { return }
        if avatarWindowID == nil {
            avatarWindowID = findAvatarWindow(expectedX: nil, expectedY: nil, layout: layout)
        }
        guard let windowID = avatarWindowID,
              let info = CGWindowListCopyWindowInfo(
                  [.optionIncludingWindow, .excludeDesktopElements],
                  windowID
              ) as? [[String: Any]],
              let window = info.first,
              let windowBounds = cgWindowBounds(window),
              abs(windowBounds.width - layout.overlayWidth) < 2,
              abs(windowBounds.height - layout.overlayHeight) < 2 else {
            avatarWindowID = nil
            return
        }
        applyPetPosition(windowX: windowBounds.minX, windowY: windowBounds.minY, layout: layout)
    }

    private func applyPetPosition(windowX: CGFloat, windowY: CGFloat, layout: PetLayout) {
        let x = windowX + layout.mascotLeft + layout.mascotWidth + 8
        let petTop = windowY + layout.mascotTop
        let y = layout.displayY + layout.displayHeight - petTop
            - (layout.mascotHeight + settingsStore.value.badgeHeight) / 2
        let petFrame = NSRect(
            x: windowX + layout.mascotLeft,
            y: layout.displayY + layout.displayHeight - petTop - layout.mascotHeight,
            width: layout.mascotWidth,
            height: layout.mascotHeight
        )
        overlay.setPetFrame(petFrame)
        overlay.setOrigin(NSPoint(x: x, y: y))
        overlay.setVisible(true)
    }

    private func findAvatarWindow(
        expectedX: CGFloat?,
        expectedY: CGFloat?,
        layout: PetLayout
    ) -> CGWindowID? {
        let codexPID = NSRunningApplication
            .runningApplications(withBundleIdentifier: "com.openai.codex")
            .first?.processIdentifier
        guard let windows = CGWindowListCopyWindowInfo(
            [.optionOnScreenOnly, .excludeDesktopElements],
            kCGNullWindowID
        ) as? [[String: Any]] else { return nil }

        let candidates = windows.compactMap { window -> (CGWindowID, NSRect, CGFloat)? in
            guard let ownerPID = number(window[kCGWindowOwnerPID as String]),
                  codexPID == nil || pid_t(ownerPID) == codexPID,
                  let windowID = number(window[kCGWindowNumber as String]),
                  let bounds = cgWindowBounds(window),
                  abs(bounds.width - layout.overlayWidth) < 2,
                  abs(bounds.height - layout.overlayHeight) < 2 else { return nil }
            let distance = abs(bounds.minX - (expectedX ?? bounds.minX))
                + abs(bounds.minY - (expectedY ?? bounds.minY))
            return (CGWindowID(windowID), bounds, distance)
        }
        return candidates.min(by: { $0.2 < $1.2 })?.0
    }

    private func cgWindowBounds(_ window: [String: Any]) -> NSRect? {
        guard let raw = window[kCGWindowBounds as String] as? [String: Any],
              let x = number(raw["X"]),
              let y = number(raw["Y"]),
              let width = number(raw["Width"]),
              let height = number(raw["Height"]) else { return nil }
        return NSRect(x: x, y: y, width: width, height: height)
    }
}

