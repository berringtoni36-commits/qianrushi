# Obsidian workspace
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/hotkeys.json
.obsidian/plugins/*/data.json

# Trash
.trash/

# System files
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.bak
*.bak-*
*.backup-*
.backup-*/
.aiw-backups/

# Claude / OpenCode session & execution data
.claudian/sessions/
.claudian/opencode/execution/

# Python cache
__pycache__/
*.pyc

# Build artifacts (C/C++ projects)
**/build/
**/CMakeFiles/
**/CMakeCache.txt
**/cmake_install.cmake
**/Makefile
**/DebugConfig/
**/*.o
**/*.obj
**/*.exe

# IDE / project files
**/*.user
**/*.pro.user*

# Local JavaScript/Remotion dependencies and generated output
**/node_modules/
**/.remotion/
projects/嵌入式八股/remotion-static-q1-demo/out/
projects/嵌入式八股/remotion-embedded-150/out/

# Large binary assets (images, fonts, videos, etc.) — use iCloud sync instead of Git
assets/
.obsidian/fonts/
*.epub
*.mp4
*.mov
*.pdf
*.so
*.ttf
*.otf
